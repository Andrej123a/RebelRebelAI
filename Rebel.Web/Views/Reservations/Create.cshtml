@model Rebel.Web.Models.ReservationCreateViewModel

@{
    ViewData["Title"] = "Book a Table";

    var showNote =
        !string.IsNullOrWhiteSpace(Model.Note) ||
        ViewData.ModelState[nameof(Model.Note)]?.Errors.Count > 0;
}

<section class="rs-chapter rs-chapter--sky rs-reserve">
    <span class="rs-stars rs-reserve-stars"></span>

    <div class="rs-container rs-reserve-grid">
        <aside class="rs-reserve-art" aria-label="Rebel Rebel">
            <span class="rs-split rs-reserve-art-photo">
                <img src="~/images/rebel-bowie-logo-room.webp"
                     alt="Bowie artwork inside Rebel Rebel" />
                <img src="~/images/rebel-bowie-logo-room.webp" alt="" aria-hidden="true" />
            </span>

            <div class="rs-reserve-art-copy">
                <img src="~/images/logo.jpg"
                     alt="Rebel Rebel by Fat Kitchen"
                     class="rs-reserve-logo" />
            </div>
        </aside>

        <form asp-controller="Reservations"
              asp-action="Create"
              method="post"
              class="rs-console rs-reserve-form">
            <input asp-for="EventId" type="hidden" />

            <div class="rs-reserve-body">
            <header>
                <h1 class="rs-display rs-display--md" aria-label="Pick your arrival.">
                    Pick your <span class="rs-accent">arrival.</span>
                </h1>
                <p class="rs-reserve-intro">
                    Choose the exact date and time. We will give you a code to track the request.
                </p>
            </header>

            <div asp-validation-summary="ModelOnly"
                 class="rs-errors"></div>

            @if (!string.IsNullOrWhiteSpace(Model.EventTitle))
            {
                <div class="rs-reserve-event">
                    <span class="rs-label">Event</span>
                    <strong>@Model.EventTitle</strong>
                </div>
            }

            <div class="rs-reserve-row rs-reserve-row--two">
                <label class="rs-field">
                    <span>Date</span>
                    <input asp-for="ReservationDate"
                           type="date"
                           min="@ViewBag.MinimumReservationDate" />
                    <span asp-validation-for="ReservationDate"></span>
                </label>

                <label class="rs-field">
                    <span>Arrival time</span>
                    <input asp-for="ReservationTime"
                           type="time"
                           min="10:00"
                           max="22:00" />
                    <span asp-validation-for="ReservationTime"></span>
                </label>
            </div>

            <p class="rs-reserve-hours">
                <i class="rs-led rs-led--gold"></i>
                Reservations from 10:00 to 22:00, at least 2 hours ahead
            </p>

            <div class="rs-reserve-row rs-reserve-row--three">
                <label class="rs-field">
                    <span>Guests</span>
                    <input asp-for="NumberOfGuests"
                           type="number"
                           inputmode="numeric"
                           min="1"
                           max="20" />
                    <span asp-validation-for="NumberOfGuests"></span>
                </label>

                <label class="rs-field">
                    <span>Full name</span>
                    <input asp-for="FullName"
                           placeholder="Your name"
                           autocomplete="name" />
                    <span asp-validation-for="FullName"></span>
                </label>

                <label class="rs-field">
                    <span>Phone</span>
                    <input asp-for="PhoneNumber"
                           placeholder="+389..."
                           autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber"></span>
                </label>
            </div>

            <details class="rs-reserve-note" open="@showNote">
                <summary>Add a note <span>optional</span></summary>
                <label class="rs-field">
                    <span>Note</span>
                    <textarea asp-for="Note"
                              rows="3"
                              placeholder="Birthday, accessibility, seating..."></textarea>
                    <span asp-validation-for="Note"></span>
                </label>
            </details>

            <p class="rs-reserve-table">
                <i class="rs-led rs-led--off"></i>
                Your table is assigned by staff when your request is approved
            </p>

            <div class="rs-reserve-submit">
                @* Major Tom sends it up to Ground Control. *@
                <partial name="_Ego" model='new EgoCall("tom", "Send it up to Ground Control. I\u2019ll radio back a code so you can follow it.", [new("Request the table")], "rs-ego--big", Button: "submit")' />
                <p>No email needed. Keep the code shown after submitting.</p>
            </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
