@model Rebel.Web.Models.ReservationCreateViewModel

@{
    ViewData["Title"] = "Book a Table";

    var showNote =
        !string.IsNullOrWhiteSpace(Model.Note) ||
        ViewData.ModelState[nameof(Model.Note)]?.Errors.Count > 0;
}

<section class="rr-reservation-simple-page">
    <div class="container">
        <div class="rr-reservation-ticket">
            <aside class="rr-reservation-art" aria-label="Rebel Rebel">
                <img class="rr-reservation-art-photo"
                     src="~/images/rebel-bowie-logo-room.webp"
                     alt="Bowie artwork inside Rebel Rebel" />

                <div class="rr-reservation-art-shade"></div>

                <div class="rr-reservation-art-copy">
                    <img src="~/images/logo.jpg"
                         alt="Rebel Rebel by Fat Kitchen"
                         class="rr-reservation-logo" />
                    <span>Skopje / Table reservations</span>
                    <strong>Come as you are.</strong>
                </div>
            </aside>

            <form asp-controller="Reservations"
                  asp-action="Create"
                  method="post"
                  class="rr-reservation-simple-form">
                <input asp-for="EventId" type="hidden" />

                <header>
                    <span>Book a table</span>
                    <h1>Pick your arrival.</h1>
                    <p>
                        Choose the exact date and time. We will give you a code to track the request.
                    </p>
                </header>

                <div asp-validation-summary="ModelOnly"
                     class="rr-reservation-errors"></div>

                @if (!string.IsNullOrWhiteSpace(Model.EventTitle))
                {
                    <div class="rr-reservation-event">
                        <span>Event</span>
                        <strong>@Model.EventTitle</strong>
                    </div>
                }

                <div class="rr-reservation-datetime">
                    <label>
                        <span>Date</span>
                        <input asp-for="ReservationDate"
                               type="date"
                               min="@ViewBag.MinimumReservationDate" />
                        <small asp-validation-for="ReservationDate"></small>
                    </label>

                    <label>
                        <span>Arrival time</span>
                        <input asp-for="ReservationTime"
                               type="time"
                               min="10:00"
                               max="22:00"
                               step="60" />
                        <small asp-validation-for="ReservationTime"></small>
                    </label>
                </div>

                <p class="rr-reservation-hours">
                    Reservations from 10:00 to 22:00 / at least 2 hours ahead
                </p>

                <div class="rr-reservation-fields">
                    <label>
                        <span>Guests</span>
                        <input asp-for="NumberOfGuests"
                               type="number"
                               inputmode="numeric"
                               min="1"
                               max="20" />
                        <small asp-validation-for="NumberOfGuests"></small>
                    </label>

                    <label>
                        <span>Full name</span>
                        <input asp-for="FullName"
                               placeholder="Your name"
                               autocomplete="name" />
                        <small asp-validation-for="FullName"></small>
                    </label>

                    <label>
                        <span>Phone</span>
                        <input asp-for="PhoneNumber"
                               placeholder="+389..."
                               autocomplete="tel" />
                        <small asp-validation-for="PhoneNumber"></small>
                    </label>
                </div>

                <details class="rr-reservation-note" open="@showNote">
                    <summary>Add a note <span>optional</span></summary>
                    <label>
                        <span>For the crew</span>
                        <textarea asp-for="Note"
                                  rows="3"
                                  placeholder="Birthday, accessibility, seating..."></textarea>
                        <small asp-validation-for="Note"></small>
                    </label>
                </details>

                <div class="rr-reservation-submit">
                    <button type="submit">Request the table</button>
                    <p>No email needed. Keep the code shown after submitting.</p>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
