@{
    ViewData["Title"] = "Reservation Sent";
}

<section class="rs-chapter rs-chapter--sky rs-booking">
    <span class="rs-stars rs-booking-stars"></span>

    @* Major Tom, drifting past the tracking station. *@
    <span class="rs-booking-helmet" aria-hidden="true" data-rs-drift="-0.16">
        <partial name="_Look" model='new LookModel("tom")' />
    </span>

    <div class="rs-container rs-booking-inner">
        <header class="rs-confirm-head">
            <div>
                <h1 class="rs-display rs-display--lg">
                    Thanks, @ViewBag.ReservationName.
                </h1>

                <p class="rs-lead">
                    Your request is now with the team. Keep your code safe; it is your shortcut to status updates and cancellation.
                </p>
            </div>
        </header>

        <div class="rs-confirm-grid">
            <div class="rs-confirm-ticket rs-ticket">
                <span class="rs-label">Reservation code</span>
                <strong id="reservationCodeValue">@ViewBag.ReservationCode</strong>
                <partial name="_Ego" model='new EgoCall("tom", "", [new("Copy the code")], "rs-ego--small", Button: "button", Attributes: new Dictionary<string, string> { ["id"] = "copyReservationCode", ["data-code"] = (string)ViewBag.ReservationCode })' />
                <p>No account needed. This code is enough to find or cancel your reservation.</p>
            </div>

            <div class="rs-console rs-confirm-details">
                <div class="rs-confirm-status">
                    <span class="rs-booking-status"><i class="rs-led rs-led--gold rs-led--blink"></i>Current status</span>
                    <strong>Pending staff approval</strong>
                    <p>The table is not final until staff approve it.</p>
                </div>

                <dl class="rs-stats">
                    <div>
                        <dt>Date</dt>
                        <dd>@ViewBag.ReservationDate</dd>
                    </div>

                    <div>
                        <dt>Time</dt>
                        <dd>@ViewBag.ReservationTime</dd>
                    </div>

                    <div>
                        <dt>Guests</dt>
                        <dd>@ViewBag.ReservationGuests</dd>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ViewBag.ReservationEvent as string))
                    {
                        <div>
                            <dt>Event</dt>
                            <dd>@ViewBag.ReservationEvent</dd>
                        </div>
                    }
                </dl>
            </div>
        </div>

        <div class="rs-confirm-next">
            <p class="rs-kicker">What happens next</p>
            <ol>
                <li>Staff checks the floor, party size, and event capacity.</li>
                <li>Your request is approved or declined by the team.</li>
                <li>Use your code anytime to track or cancel before the booking time.</li>
            </ol>
        </div>

        <div class="rs-egos rs-confirm-actions">
            <partial name="_Ego" model='new EgoCall("tom", "Message received at Ground Control. Read me your code any time and I\u2019ll tell you where it stands.", [new("Find my booking", Url.Action("Lookup", "Reservations"))], "rs-ego--big")' />
            <partial name="_Ego" model='BowieCalls.Home(Url, "rs-ego--small")' />
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const button = document.getElementById("copyReservationCode");

            if (!button) {
                return;
            }

            // Major Tom answers in his bubble.
            const label = button.querySelector("[data-ego-act]") ?? button;

            button.addEventListener("click", async () => {
                const code = button.dataset.code ?? "";

                try {
                    await navigator.clipboard.writeText(code);
                    label.textContent = "Copied";
                } catch {
                    const codeElement =
                        document.getElementById("reservationCodeValue");

                    if (codeElement) {
                        const range = document.createRange();
                        range.selectNodeContents(codeElement);
                        const selection = window.getSelection();
                        selection?.removeAllRanges();
                        selection?.addRange(range);
                    }

                    label.textContent = "Selected";
                }

                window.setTimeout(() => {
                    label.textContent = "Copy the code";
                }, 1800);
            });
        })();
    </script>
}
