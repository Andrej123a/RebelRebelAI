@{
    ViewData["Title"] = "Reservation Sent";

    string code = ViewBag.ReservationCode ?? string.Empty;
}

<section class="rs-chapter rs-chapter--sky rs-booking">
    <span class="rs-stars rs-booking-stars"></span>

    <div class="rs-container rs-booking-inner">
        <header class="rs-confirm-head">
            <div>
                <h1 class="rs-display rs-display--lg">
                    Thanks, @ViewBag.ReservationName.
                </h1>

                <p class="rs-lead">
                    Your request is now with the team. Keep your code safe; it is your shortcut to status updates and cancellation.
                </p>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(code))
        {
            @* Ground Control radios back: Major Tom's tin can keeps flying across the screen
               with your code on a banner waving behind it (hold the pointer on it and he waits;
               click it to copy). With less motion it hangs here. *@
            <div class="rs-flyby" data-rs-flyby>
                <div class="rs-flyby-convoy">
                    <p class="rs-flyby-banner" data-rs-copy="@code" title="Click to copy">
                        <small>Your code</small>
                        <strong>@code</strong>
                    </p>
                    <span class="rs-flyby-line" aria-hidden="true"></span>
                    <span class="rs-flyby-ship" aria-hidden="true">
                        <span class="rs-flyby-craft">
                            <img class="rs-flight-can" src="~/art/ships/tincan.webp" asp-append-version="true" width="400" height="520" alt="" decoding="async" />
                            <span class="rs-flight-hatch">
                                <img class="rs-flight-tom" src="~/art/looks/tom.webp" asp-append-version="true" width="400" height="520" alt="" decoding="async" />
                            </span>
                        </span>
                    </span>
                </div>
            </div>
        }

        <div class="rs-confirm-grid">
            @* You cannot chase a spaceship: Major Tom copies the code for you. *@
            <div class="rs-confirm-copy">
                <partial name="_Ego" model='new EgoCall("tom", "That\u2019s your code flying behind me. Can\u2019t catch it? I\u2019ll copy it for you.", [new("Copy the code")], "rs-ego--big", Button: "button", Attributes: new Dictionary<string, string> { ["id"] = "copyReservationCode", ["data-code"] = code })' />
                <p>No account needed: this code is enough to find or cancel your reservation.</p>
            </div>

            <div class="rs-console rs-confirm-details">
                <div class="rs-confirm-status">
                    <span class="rs-booking-status"><i class="rs-led rs-led--gold rs-led--blink"></i>Current status</span>
                    <strong>Pending staff approval</strong>
                    <p>The table is not final until staff approve it.</p>
                </div>

                <dl class="rs-stats">
                    <div>
                        <dt>Date</dt>
                        <dd>@ViewBag.ReservationDate</dd>
                    </div>

                    <div>
                        <dt>Time</dt>
                        <dd>@ViewBag.ReservationTime</dd>
                    </div>

                    <div>
                        <dt>Guests</dt>
                        <dd>@ViewBag.ReservationGuests</dd>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ViewBag.ReservationEvent as string))
                    {
                        <div>
                            <dt>Event</dt>
                            <dd>@ViewBag.ReservationEvent</dd>
                        </div>
                    }
                </dl>
            </div>
        </div>

        <div class="rs-confirm-next">
            <p class="rs-kicker">What happens next</p>
            <ol>
                <li>Staff checks the floor, party size, and event capacity.</li>
                <li>Your request is approved or declined by the team.</li>
                <li>Use your code anytime to track or cancel before the booking time.</li>
            </ol>
        </div>

        <div class="rs-egos rs-confirm-actions">
            <partial name="_Ego" model='new EgoCall("tom", "Message received at Ground Control. Read me your code any time and I\u2019ll tell you where it stands.", [new("Find my booking", Url.Action("Lookup", "Reservations"))], "rs-ego--big")' />
            <partial name="_Ego" model='BowieCalls.Home(Url, "rs-ego--small")' />
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            // Major Tom copies the code: from his button, or from the banner if you catch it.
            const button = document.getElementById("copyReservationCode");
            const label = button?.querySelector("[data-ego-act]") ?? button;
            const banner = document.querySelector("[data-rs-copy]");
            const code = button?.dataset.code ?? banner?.dataset.rsCopy ?? "";
            let resting = 0;

            const copy = async () => {
                let words = "Copied";

                try {
                    await navigator.clipboard.writeText(code);
                } catch {
                    // No clipboard: select the code on the banner instead.
                    const strong = banner?.querySelector("strong");

                    if (strong) {
                        const range = document.createRange();
                        range.selectNodeContents(strong);
                        const selection = window.getSelection();
                        selection?.removeAllRanges();
                        selection?.addRange(range);
                    }

                    words = "Selected";
                }

                if (label) {
                    label.textContent = words;
                }

                banner?.classList.add("is-copied");
                window.clearTimeout(resting);
                resting = window.setTimeout(() => {
                    if (label) {
                        label.textContent = "Copy the code";
                    }

                    banner?.classList.remove("is-copied");
                }, 1800);
            };

            button?.addEventListener("click", copy);
            banner?.addEventListener("click", copy);
        })();
    </script>
}
