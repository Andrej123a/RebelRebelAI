@model AdminStaffScheduleViewModel
@using Rebel.Domain.Entities
@using Rebel.Domain.Enums
@using Rebel.Web.Authorization

@{
    ViewData["Title"] = "Staff Schedule";

    var canManage = User.IsInRole(AdminRoles.Manager) || User.IsInRole(AdminRoles.LegacyAdmin);
    var days = Enumerable.Range(0, 7).Select(offset => Model.StartDate.AddDays(offset)).ToList();
    var activeStaff = Model.StaffMembers.Where(staff => staff.IsActive)
        .OrderBy(staff => staff.Role).ThenBy(staff => staff.FullName).ToList();
    var shiftsByDay = Model.Shifts.GroupBy(shift => shift.ShiftDate.Date)
        .ToDictionary(group => group.Key, group => group.OrderBy(shift => shift.StartsAt).ToList());
    var shiftsByStaff = Model.Shifts.GroupBy(shift => shift.StaffMemberId)
        .ToDictionary(group => group.Key, group => group.Count());
    var eventsByDay = Model.Events.GroupBy(eventItem => eventItem.Date.Date)
        .ToDictionary(group => group.Key, group => group.ToList());
    var shiftPeriods = new[]
    {
        new { Key = "first", Label = "First", Start = new TimeSpan(10, 0, 0), End = new TimeSpan(16, 0, 0) },
        new { Key = "middle", Label = "Middle", Start = new TimeSpan(12, 0, 0), End = new TimeSpan(20, 0, 0) },
        new { Key = "second", Label = "Second", Start = new TimeSpan(16, 0, 0), End = TimeSpan.Zero }
    };

    string ResolvePeriod(StaffShift shift)
    {
        if (shift.StartsAt < new TimeSpan(12, 0, 0)) return "first";
        return shift.StartsAt < new TimeSpan(16, 0, 0) ? "middle" : "second";
    }

    var scheduleWarnings = new List<string>();
    var today = DateTime.Today;
    foreach (var day in days)
    {
        var dayShifts = shiftsByDay.GetValueOrDefault(day.Date) ?? new List<StaffShift>();
        var dayEvents = eventsByDay.GetValueOrDefault(day.Date) ?? new List<StaffScheduleEventViewModel>();
        if (dayEvents.Count > 0 && !dayShifts.Any(shift => shift.Role == StaffRole.Front))
            scheduleWarnings.Add($"{day:ddd dd MMM}: event night has no front cover.");
        if (dayEvents.Count > 0 && !dayShifts.Any(shift => shift.Role == StaffRole.Kitchen))
            scheduleWarnings.Add($"{day:ddd dd MMM}: event night has no kitchen cover.");
    }
}

<div class="admin-workspace staff-rota-workspace">
    <header class="admin-workspace-header staff-rota-page-header">
        <div class="admin-workspace-heading">
            <span class="admin-workspace-eyebrow">Weekly rota</span>
            <h1 class="admin-workspace-title">Staff</h1>
            <p class="admin-workspace-copy">
                @Model.StartDate.ToString("dd MMM") - @Model.EndDate.ToString("dd MMM yyyy")
                / drag a person into a shift.
            </p>
        </div>
        <div class="admin-workspace-actions">
            @if (canManage && Model.EndDate.Date >= today)
            {
                <form asp-controller="AdminStaffSchedule" asp-action="CopyPreviousWeek" method="post"
                      onsubmit="return confirm('Fill this week with shifts from last week? Existing shifts will stay unchanged.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="admin-secondary-button">Copy last week</button>
                </form>
            }
            <a asp-action="Index" asp-route-startDate="@Model.PreviousWeek.ToString("yyyy-MM-dd")" class="admin-secondary-button">Previous</a>
            <a asp-action="Index" asp-route-startDate="@DateTime.Today.ToString("yyyy-MM-dd")" class="admin-primary-button">This week</a>
            <a asp-action="Index" asp-route-startDate="@Model.NextWeek.ToString("yyyy-MM-dd")" class="admin-secondary-button">Next</a>
        </div>
    </header>

    @if (scheduleWarnings.Count > 0)
    {
        <div class="staff-rota-alert" role="status">
            <strong>@scheduleWarnings.Count coverage warning@(scheduleWarnings.Count == 1 ? "" : "s")</strong>
            <span>@string.Join(" / ", scheduleWarnings)</span>
        </div>
    }

    <div class="staff-rota-layout">
        <main class="staff-rota-board" aria-label="Weekly staff schedule">
            <header class="staff-rota-board-heading">
                <div><span>Week plan</span><strong>Three shifts per day</strong></div>
                <p>Select a person, then click a shift, or drag and drop.</p>
            </header>

            @foreach (var day in days)
            {
                var dayShifts = shiftsByDay.GetValueOrDefault(day.Date) ?? new List<StaffShift>();
                var dayEvents = eventsByDay.GetValueOrDefault(day.Date) ?? new List<StaffScheduleEventViewModel>();
                var isPastDay = day.Date < today;

                <article class="staff-rota-day @(day.Date == today ? "is-today" : "") @(isPastDay ? "is-locked" : "")">
                    <header class="staff-rota-day-heading">
                        <span>@day.ToString("ddd")</span>
                        <strong>@day.ToString("dd MMM")</strong>
                        <small>@(isPastDay ? "Locked" : $"{dayShifts.Count} assigned")</small>
                    </header>
                    <div class="staff-rota-day-content">
                        @if (dayEvents.Count > 0)
                        {
                            <div class="staff-rota-events">
                                @foreach (var eventItem in dayEvents)
                                {
                                    <a asp-controller="AdminEvents" asp-action="Bookings" asp-route-id="@eventItem.Id">
                                        <strong>@eventItem.Title</strong>
                                        <span>@(eventItem.StartTime?.ToString(@"hh\:mm") ?? "TBC") / @eventItem.GuestCount guests</span>
                                    </a>
                                }
                            </div>
                        }
                        <div class="staff-rota-periods">
                            @foreach (var period in shiftPeriods)
                            {
                                var periodShifts = dayShifts.Where(shift => ResolvePeriod(shift) == period.Key)
                                    .OrderBy(shift => shift.Role).ThenBy(shift => shift.StaffMember!.FullName).ToList();

                                <section class="staff-rota-period" data-shift-drop
                                         data-locked="@isPastDay.ToString().ToLowerInvariant()"
                                         data-date="@day.ToString("yyyy-MM-dd")"
                                         data-start="@period.Start.ToString(@"hh\:mm")"
                                         data-end="@period.End.ToString(@"hh\:mm")"
                                         tabindex="@(canManage && !isPastDay ? "0" : "-1")"
                                         aria-label="Assign staff to @period.Label shift on @day.ToString("dddd")">
                                    <header>
                                        <div><span>@period.Label shift</span><strong>@period.Start.ToString(@"hh\:mm") - @period.End.ToString(@"hh\:mm")</strong></div>
                                        <small>@periodShifts.Count</small>
                                    </header>
                                    <div class="staff-rota-assignments">
                                        @foreach (var shift in periodShifts)
                                        {
                                            var initial = string.IsNullOrWhiteSpace(shift.StaffMember?.FullName) ? "?" : shift.StaffMember.FullName.Trim()[0].ToString();
                                            <article class="staff-rota-assignment role-@shift.Role.ToString().ToLowerInvariant()">
                                                @if (canManage && !isPastDay)
                                                {
                                                    <button type="button" class="staff-rota-assignment-main" data-shift-edit
                                                            data-shift-id="@shift.Id" data-staff-id="@shift.StaffMemberId"
                                                            data-shift-date="@shift.ShiftDate.ToString("yyyy-MM-dd")"
                                                            data-shift-date-label="@shift.ShiftDate.ToString("dddd, dd MMMM")"
                                                            data-shift-start="@shift.StartsAt.ToString(@"hh\:mm")"
                                                            data-shift-end="@shift.EndsAt.ToString(@"hh\:mm")" data-shift-note="@shift.Note">
                                                        <span class="staff-rota-avatar">@initial</span>
                                                        <span><strong>@shift.StaffMember?.FullName</strong><small>@shift.Role / @shift.StartsAt.ToString(@"hh\:mm") - @shift.EndsAt.ToString(@"hh\:mm")</small></span>
                                                    </button>
                                                    <form asp-action="DeleteShift" method="post" onsubmit="return confirm('Remove this shift?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@shift.Id" />
                                                        <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                                                        <button type="submit" aria-label="Remove @shift.StaffMember?.FullName from shift">&times;</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <div class="staff-rota-assignment-main">
                                                        <span class="staff-rota-avatar">@initial</span>
                                                        <span><strong>@shift.StaffMember?.FullName</strong><small>@shift.Role / @shift.StartsAt.ToString(@"hh\:mm") - @shift.EndsAt.ToString(@"hh\:mm")</small></span>
                                                    </div>
                                                }
                                            </article>
                                        }
                                        @if (periodShifts.Count == 0 && !isPastDay)
                                        {
                                            <div class="staff-rota-empty-slot"><span>Drop staff here</span><small>or select staff and click</small></div>
                                        }
                                        else if (periodShifts.Count == 0)
                                        {
                                            <div class="staff-rota-empty-slot is-locked"><span>Past shift</span><small>Locked</small></div>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </article>
            }
        </main>

        @if (canManage)
        {
            <aside class="staff-rota-sidebar">
                <section class="staff-rota-add-person">
                    <header><span>New staff</span><strong>Add a person</strong></header>
                    <form asp-action="CreateStaff" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        <label>Name <input name="FullName" maxlength="80" placeholder="Full name" required /></label>
                        <label>Section
                            <select name="Role">
                                @foreach (var role in Enum.GetValues<StaffRole>()) { <option value="@role">@role</option> }
                            </select>
                        </label>
                        <label>Phone <small>optional</small><input name="PhoneNumber" maxlength="40" placeholder="Phone number" /></label>
                        <button type="submit" class="admin-primary-button">Add to staff</button>
                    </form>
                </section>

                <section class="staff-rota-pool">
                    <header><div><span>Available staff</span><strong>Drag to schedule</strong></div><small>@activeStaff.Count active</small></header>
                    @foreach (var role in Enum.GetValues<StaffRole>())
                    {
                        var roleStaff = activeStaff.Where(staff => staff.Role == role).ToList();
                        <div class="staff-rota-pool-group">
                            <span>@role</span>
                            @foreach (var staffMember in roleStaff)
                            {
                                var initial = string.IsNullOrWhiteSpace(staffMember.FullName) ? "?" : staffMember.FullName.Trim()[0].ToString();
                                <button type="button" class="staff-rota-person role-@role.ToString().ToLowerInvariant()" draggable="true"
                                        data-staff-drag data-staff-id="@staffMember.Id">
                                    <span class="staff-rota-avatar">@initial</span>
                                    <span><strong>@staffMember.FullName</strong><small>@role / @shiftsByStaff.GetValueOrDefault(staffMember.Id) this week</small></span>
                                    <b aria-hidden="true">::</b>
                                </button>
                            }
                        </div>
                    }
                </section>
            </aside>

            <form asp-action="CreateShift" method="post" id="staffDropForm" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="StaffMemberId" id="dropStaffId" />
                <input type="hidden" name="ShiftDate" id="dropShiftDate" />
                <input type="hidden" name="StartsAt" id="dropShiftStart" />
                <input type="hidden" name="EndsAt" id="dropShiftEnd" />
            </form>

            <dialog class="admin-quick-panel" id="staffShiftEditDialog" aria-labelledby="editShiftTitle">
                <form asp-action="EditShift" method="post" class="admin-quick-panel-shell">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="editShiftId" />
                    <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    <header class="admin-quick-panel-header">
                        <div><span>Edit shift</span><h2 id="editShiftTitle">Scheduled shift</h2><p id="editShiftDateLabel"></p></div>
                        <button type="button" data-shift-edit-close aria-label="Close shift editor">&times;</button>
                    </header>
                    <div class="admin-quick-panel-body"><div class="admin-quick-form">
                        <label>Staff member<select name="StaffMemberId" id="editShiftStaff" required>
                            @foreach (var staffMember in activeStaff) { <option value="@staffMember.Id">@staffMember.FullName / @staffMember.Role</option> }
                        </select></label>
                        <label>Date <input type="date" name="ShiftDate" id="editShiftDate" required /></label>
                        <div class="staff-cover-time-fields">
                            <label>Start <input type="time" name="StartsAt" id="editShiftStart" required /></label>
                            <label>End <input type="time" name="EndsAt" id="editShiftEnd" required /></label>
                        </div>
                        <label>Note <textarea name="Note" id="editShiftNote" rows="3" maxlength="160" placeholder="Optional shift note"></textarea></label>
                    </div></div>
                    <footer class="admin-quick-panel-actions">
                        <button type="button" class="admin-secondary-button" data-shift-edit-close>Cancel</button>
                        <button type="submit" class="admin-primary-button">Save shift</button>
                    </footer>
                </form>
            </dialog>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const people = [...document.querySelectorAll("[data-staff-drag]")];
            const slots = [...document.querySelectorAll("[data-shift-drop]")]
                .filter(slot => slot.dataset.locked !== "true");
            const dropForm = document.getElementById("staffDropForm");
            const fields = {
                staff: document.getElementById("dropStaffId"), date: document.getElementById("dropShiftDate"),
                start: document.getElementById("dropShiftStart"), end: document.getElementById("dropShiftEnd")
            };
            let selectedStaffId = "";

            const selectPerson = person => {
                selectedStaffId = person.dataset.staffId ?? "";
                people.forEach(item => item.classList.toggle("is-selected", item === person));
                slots.forEach(slot => slot.classList.toggle("is-ready", Boolean(selectedStaffId)));
            };
            const assign = (staffId, slot) => {
                if (!staffId || !dropForm || !fields.staff || !fields.date || !fields.start || !fields.end) return;
                fields.staff.value = staffId; fields.date.value = slot.dataset.date ?? "";
                fields.start.value = slot.dataset.start ?? ""; fields.end.value = slot.dataset.end ?? "";
                slot.classList.add("is-saving"); dropForm.requestSubmit();
            };

            people.forEach(person => {
                person.addEventListener("click", () => selectPerson(person));
                person.addEventListener("dragstart", event => {
                    selectPerson(person); event.dataTransfer?.setData("text/plain", selectedStaffId);
                    if (event.dataTransfer) event.dataTransfer.effectAllowed = "copy";
                });
            });
            slots.forEach(slot => {
                slot.addEventListener("dragover", event => { event.preventDefault(); slot.classList.add("is-over"); });
                slot.addEventListener("dragleave", () => slot.classList.remove("is-over"));
                slot.addEventListener("drop", event => {
                    event.preventDefault(); slot.classList.remove("is-over");
                    assign(event.dataTransfer?.getData("text/plain") || selectedStaffId, slot);
                });
                slot.addEventListener("click", event => {
                    if (!event.target.closest("button, form, a") && selectedStaffId) assign(selectedStaffId, slot);
                });
                slot.addEventListener("keydown", event => {
                    if ((event.key === "Enter" || event.key === " ") && selectedStaffId) { event.preventDefault(); assign(selectedStaffId, slot); }
                });
            });

            const editDialog = document.getElementById("staffShiftEditDialog");
            const editFields = {
                id: document.getElementById("editShiftId"), staff: document.getElementById("editShiftStaff"),
                date: document.getElementById("editShiftDate"), start: document.getElementById("editShiftStart"),
                end: document.getElementById("editShiftEnd"), note: document.getElementById("editShiftNote"),
                label: document.getElementById("editShiftDateLabel")
            };
            document.querySelectorAll("[data-shift-edit]").forEach(button => button.addEventListener("click", () => {
                if (!(editDialog instanceof HTMLDialogElement)) return;
                if (editFields.id) editFields.id.value = button.dataset.shiftId ?? "";
                if (editFields.staff) editFields.staff.value = button.dataset.staffId ?? "";
                if (editFields.date) editFields.date.value = button.dataset.shiftDate ?? "";
                if (editFields.start) editFields.start.value = button.dataset.shiftStart ?? "";
                if (editFields.end) editFields.end.value = button.dataset.shiftEnd ?? "";
                if (editFields.note) editFields.note.value = button.dataset.shiftNote ?? "";
                if (editFields.label) editFields.label.textContent = button.dataset.shiftDateLabel ?? "";
                editDialog.showModal();
            }));
            document.querySelectorAll("[data-shift-edit-close]").forEach(button => button.addEventListener("click", () => editDialog?.close()));
        })();
    </script>
}
