@model Rebel.Domain.Entities.Event
@using System.Globalization

@{
    ViewData["Title"] = Model.Title;
    var timeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Skopje");
    var eventUtcDate = Model.Date.Kind == DateTimeKind.Utc
        ? Model.Date
        : DateTime.SpecifyKind(Model.Date, DateTimeKind.Utc);
    var localEventDate = TimeZoneInfo.ConvertTimeFromUtc(eventUtcDate, timeZone).Date;
    var startTime = Model.StartTime.HasValue ? Model.StartTime.Value.ToString(@"hh\:mm") : "TBA";
    var endTime = Model.EndTime.HasValue ? Model.EndTime.Value.ToString(@"hh\:mm") : "LATE";
}

<section class="rs-chapter rs-chapter--deep rs-event" data-rs-stardust>
    <span class="rs-stars rs-event-stars"></span>

    <partial name="_Era" model='new EraModel("1980", "tape", "Ashes to Ashes")' />

    <partial name="_Hud" />

    <div class="rs-container">
        <a asp-controller="Events"
           asp-action="Index"
           class="rs-btn rs-btn--small rs-btn--ghost rs-event-back">
            <i aria-hidden="true">&larr;</i> All events
        </a>

        <article class="rs-event-grid">
            <div class="rs-event-visual" data-rs-vhs>
                <div class="rs-vhs rs-event-poster">
                    <span class="rs-vhs-osd rs-vhs-osd--play">PLAY &#9654;</span>
                    <span class="rs-vhs-osd rs-vhs-osd--time">SP @startTime:00</span>
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" />
                    }
                    else
                    {
                        <div class="rs-events-placeholder">
                            <svg viewBox="0 0 100 100" aria-hidden="true"><use href="#rs-bolt" /></svg>
                            No poster. Still a good night.
                        </div>
                    }
                </div>
            </div>

            <div class="rs-event-copy">
                <p class="rs-kicker">Tape no. @localEventDate.ToString("dd") · Rebel Rebel presents</p>

                <h1 class="rs-display rs-display--lg">@Model.Title</h1>

                <dl class="rs-stats rs-event-stats">
                    <div>
                        <dt>Day</dt>
                        <dd>@localEventDate.ToString("dddd", CultureInfo.InvariantCulture)</dd>
                    </div>
                    <div>
                        <dt>Date</dt>
                        <dd>@localEventDate.ToString("dd.MM.yyyy")</dd>
                    </div>
                    <div>
                        <dt>Start</dt>
                        <dd>@startTime</dd>
                    </div>
                    <div>
                        <dt>Until</dt>
                        <dd>@endTime</dd>
                    </div>
                </dl>

                <p class="rs-lead">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "One more reason to cancel your quiet night at home."
                        : Model.Description)
                </p>

                <div class="rs-event-callout rs-flood rs-flood--yellow">
                    <span class="rs-label">One night.</span>
                    <strong>Zero good excuses.</strong>
                </div>

                <div class="rs-event-actions">
                    <a asp-controller="Reservations"
                       asp-action="Create"
                       asp-route-eventId="@Model.Id"
                       class="rs-btn rs-btn--primary">
                        Claim your table <i aria-hidden="true">&rarr;</i>
                    </a>

                    <span class="rs-pill">Wanted after @startTime</span>
                </div>

                <span class="rs-event-stamp" aria-hidden="true">Guilty of<br />good times</span>
            </div>
        </article>
    </div>
</section>
