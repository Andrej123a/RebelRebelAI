@model List<Rebel.Domain.Entities.Event>
@using System.Globalization

@{
    ViewData["Title"] = "Events";

    var events = Model ?? new List<Rebel.Domain.Entities.Event>();

    var nextEvent = events
        .OrderBy(e => e.Date)
        .ThenBy(e => e.StartTime)
        .FirstOrDefault();

    var tones = new[]
    {
        "var(--z-gold)",
        "var(--z-cream)",
        "var(--z-blue)",
        "var(--z-yellow)"
    };
}

@functions {
    public string FormatEventDate(DateTime date)
    {
        var skopjeTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Skopje");

        var today = TimeZoneInfo
            .ConvertTimeFromUtc(DateTime.UtcNow, skopjeTimeZone)
            .Date;

        var eventDate = date.Date;

        if (eventDate == today)
            return "Tonight";

        if (eventDate == today.AddDays(1))
            return "Tomorrow";

        if (eventDate > today && eventDate <= today.AddDays(7))
            return $"This {eventDate.ToString("dddd", CultureInfo.InvariantCulture)}";

        return eventDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    }

    public string FormatTime(TimeSpan time)
    {
        return time.ToString(@"hh\:mm");
    }
}

<section class="rs-events">

    <header class="rs-chapter rs-chapter--sky rs-events-hero" data-rs-stardust>
        <span class="rs-stars rs-events-stars"></span>

        @* Pierrot, from the Ashes to Ashes video, hosts the nights, in front of a band on stage. *@
        <partial name="_Photo" model='new PhotoModel("pierrot", "rs-page-photo rs-page-photo--events", "(max-width: 760px) 100vw, 50vw")' />
        <partial name="_Look" model='new LookModel("pierrot", "rs-page-look rs-page-look--events")' />


        <div class="rs-container rs-events-hero-grid @(nextEvent == null ? "has-no-feature" : string.Empty)">
            <div>
                <h1 class="rs-display rs-display--xl" aria-label="The night starts here.">
                    The <span class="rs-accent">night</span>
                    <span class="rs-events-here">starts here.</span>
                </h1>

                @* Pierrot hosts the nights. *@
                <partial name="_Ego" model='new EgoCall("pierrot", "Live music and special nights. Here is what is coming up.", [new("See what\u2019s on", "#upcoming-events")], "rs-ego--big rs-events-scroll")' />
            </div>

            @if (nextEvent != null)
            {
                <a asp-controller="Events"
                   asp-action="Details"
                   asp-route-id="@nextEvent.Id"
                   class="rs-events-feature"
                   aria-label="View next event: @nextEvent.Title"
                   data-rs-vhs>
                    <span class="rs-vhs rs-events-feature-poster">
                        @if (!string.IsNullOrWhiteSpace(nextEvent.ImageUrl))
                        {
                            <img src="@Url.Content(nextEvent.ImageUrl)" alt="" />
                        }
                        else
                        {
                            <span class="rs-events-placeholder"></span>
                        }
                    </span>

                    <span class="rs-events-feature-copy">
                        <span class="rs-label">
                            Next up · @FormatEventDate(nextEvent.Date)
                            @if (nextEvent.StartTime.HasValue)
                            {
                                <text> · @FormatTime(nextEvent.StartTime.Value)</text>
                            }
                        </span>
                        <strong>@nextEvent.Title</strong>
                        <span class="rs-events-feature-link">View event <i aria-hidden="true">&nearr;</i></span>
                    </span>
                </a>
            }
        </div>
    </header>

    <section class="rs-section rs-events-lineup" id="upcoming-events">
        <div class="rs-container">
            <header class="rs-heading">
                <div>
                    <h2 class="rs-display rs-display--lg" aria-label="Upcoming nights">
                        Upcoming <span class="rs-scrawl rs-display-scrawl">nights</span>
                    </h2>
                </div>
            </header>

            @if (events.Any())
            {
                <ol class="rs-events-list">
                    @for (var i = 0; i < events.Count; i++)
                    {
                        var e = events[i];

                        <li class="rs-events-row" style="--tone: @tones[i % tones.Length];" data-rs-reveal data-rs-vhs>
                            <div class="rs-events-date">
                                <strong>@e.Date.ToString("dd")</strong>
                                <span>@e.Date.ToString("MMM", CultureInfo.InvariantCulture)</span>
                                <small>@e.Date.ToString("ddd", CultureInfo.InvariantCulture)</small>
                            </div>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@e.Id"
                               class="rs-vhs rs-events-poster"
                               tabindex="-1"
                               aria-hidden="true">
                                @if (!string.IsNullOrWhiteSpace(e.ImageUrl))
                                {
                                    <img src="@e.ImageUrl" alt="" loading="lazy" draggable="false" />
                                }
                                else
                                {
                                    <span class="rs-events-placeholder"></span>
                                }
                            </a>

                            <div class="rs-events-copy">
                                @if (e.StartTime.HasValue)
                                {
                                    <span class="rs-label">@FormatTime(e.StartTime.Value)</span>
                                }

                                <h3>
                                    <a asp-controller="Events"
                                       asp-action="Details"
                                       asp-route-id="@e.Id">@e.Title</a>
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(e.Description))
                                {
                                    <p>@e.Description</p>
                                }
                            </div>

                            @* Major Tom books you in for the night; Pierrot tells you about it. *@
                            <div class="rs-events-actions">
                                <partial name="_Ego" model='new EgoCall("tom", "", [new("Book for this night", Url.Action("Create", "Reservations", new { eventId = e.Id }))], "rs-ego--small rs-events-reserve")' />
                                <partial name="_Ego" model='new EgoCall("pierrot", "", [new("See the night", Url.Action("Details", "Events", new { id = e.Id }))], "rs-ego--small")' />
                            </div>
                        </li>
                    }
                </ol>
            }
            else
            {
                <div class="rs-events-empty">
                    <h3 class="rs-display rs-display--sm">No upcoming events right now.</h3>

                    <partial name="_Ego" model='BowieCalls.Home(Url, "rs-ego--small")' />
                </div>
            }
        </div>
    </section>

    <section class="rs-chapter rs-chapter--gold rs-torn rs-events-cta">
        <div class="rs-container rs-events-cta-inner">
            <div>
                <h2 class="rs-display rs-display--lg">Book a table<br />for the night.</h2>
            </div>

            <partial name="_Ego" model="BowieCalls.Book(Url)" />
        </div>
    </section>

</section>
