@model List<Rebel.Domain.Entities.Event>
@using System.Globalization

@{
    ViewData["Title"] = "Events";

    var events = Model ?? new List<Rebel.Domain.Entities.Event>();

    var nextEvent = events
        .OrderBy(e => e.Date)
        .ThenBy(e => e.StartTime)
        .FirstOrDefault();

    var tones = new[]
    {
        "var(--z-gold)",
        "var(--z-cream)",
        "var(--z-blue)",
        "var(--z-yellow)"
    };
}

@functions {
    public string FormatEventDate(DateTime date)
    {
        var skopjeTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Skopje");

        var today = TimeZoneInfo
            .ConvertTimeFromUtc(DateTime.UtcNow, skopjeTimeZone)
            .Date;

        var eventDate = date.Date;

        if (eventDate == today)
            return "Tonight";

        if (eventDate == today.AddDays(1))
            return "Tomorrow";

        if (eventDate > today && eventDate <= today.AddDays(7))
            return $"This {eventDate.ToString("dddd", CultureInfo.InvariantCulture)}";

        return eventDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    }

    public string FormatTime(TimeSpan time)
    {
        return time.ToString(@"hh\:mm");
    }
}

<section class="rs-events">

    <header class="rs-chapter rs-chapter--sky rs-events-hero" data-rs-stardust>
        <span class="rs-stars rs-events-stars"></span>

        <partial name="_Era" model='new EraModel("1980", "tape", "Ashes to Ashes")' />

        <partial name="_Hud" model='new HudModel("RR-80", "Tape rolling")' />

        <svg class="rs-events-tape" viewBox="0 0 100 100" aria-hidden="true" data-rs-drift="-0.14"><use href="#rs-tape" /></svg>

        <div class="rs-container rs-events-hero-grid @(nextEvent == null ? "has-no-feature" : string.Empty)">
            <div>
                <p class="rs-kicker">Rebel Rebel nights · Recorded live</p>

                <h1 class="rs-display rs-display--xl" aria-label="The night starts here.">
                    The <span class="rs-accent">night</span>
                    <span class="rs-events-here">starts here.</span>
                </h1>

                <p class="rs-lead">
                    Live music, loud nights, cold beer and the kind of stories
                    that should probably stay at the pub.
                </p>

                <dl class="rs-stats rs-events-stats">
                    <div>
                        <dt>Upcoming</dt>
                        <dd>@events.Count</dd>
                    </div>

                    @if (nextEvent != null)
                    {
                        <div>
                            <dt>Next: @nextEvent.Title</dt>
                            <dd>@FormatEventDate(nextEvent.Date)</dd>
                        </div>
                    }
                </dl>

                <a href="#upcoming-events" class="rs-btn rs-btn--ghost rs-events-scroll">
                    Explore the lineup <i aria-hidden="true">&darr;</i>
                </a>
            </div>

            @if (nextEvent != null)
            {
                <a asp-controller="Events"
                   asp-action="Details"
                   asp-route-id="@nextEvent.Id"
                   class="rs-events-feature"
                   aria-label="View next event: @nextEvent.Title"
                   data-rs-vhs>
                    <span class="rs-vhs rs-events-feature-poster">
                        <span class="rs-vhs-osd rs-vhs-osd--play">PLAY &#9654;</span>
                        <span class="rs-vhs-osd rs-vhs-osd--time">SP @(nextEvent.StartTime.HasValue ? FormatTime(nextEvent.StartTime.Value) : "--:--"):00</span>
                        @if (!string.IsNullOrWhiteSpace(nextEvent.ImageUrl))
                        {
                            <img src="@Url.Content(nextEvent.ImageUrl)" alt="" />
                        }
                        else
                        {
                            <span class="rs-events-placeholder">
                                <svg viewBox="0 0 100 100" aria-hidden="true"><use href="#rs-bolt" /></svg>
                                The next night awaits.
                            </span>
                        }
                    </span>

                    <span class="rs-events-feature-date">
                        <strong>@nextEvent.Date.ToString("dd")</strong>
                        @nextEvent.Date.ToString("MMM", CultureInfo.InvariantCulture)
                    </span>

                    <span class="rs-events-feature-copy">
                        <span class="rs-label">
                            Next up · @FormatEventDate(nextEvent.Date)
                            @if (nextEvent.StartTime.HasValue)
                            {
                                <text> · @FormatTime(nextEvent.StartTime.Value)</text>
                            }
                        </span>
                        <strong>@nextEvent.Title</strong>
                        <span class="rs-events-feature-link">View event <i aria-hidden="true">&nearr;</i></span>
                    </span>
                </a>
            }
        </div>
    </header>

    @if (events.Any())
    {
        <div class="rs-tapes" aria-hidden="true">
        <div class="rs-marquee rs-marquee--small">
            <div class="rs-marquee-track">
                @for (var copy = 0; copy < 2; copy++)
                {
                    <div class="rs-marquee-group">
                        @for (var repeat = 0; repeat < (events.Count < 4 ? 3 : 1); repeat++)
                        {
                            @foreach (var e in events)
                            {
                                <span class="rs-marquee-item">@e.Title</span>
                            }
                        }
                    </div>
                }
            </div>
        </div>
        </div>
    }

    <section class="rs-section rs-events-lineup" id="upcoming-events">
        <div class="rs-container">
            <header class="rs-heading">
                <div>
                    <p class="rs-kicker rs-kicker--red">Don't miss out</p>
                    <h2 class="rs-display rs-display--lg" aria-label="Upcoming nights">
                        Upcoming <span class="rs-scrawl rs-display-scrawl">nights</span>
                    </h2>
                </div>

                <p>
                    Every night on one list, like the back of a tour shirt.
                    Pick the night and claim your table.
                </p>
            </header>

            @if (events.Any())
            {
                <ol class="rs-events-list">
                    @for (var i = 0; i < events.Count; i++)
                    {
                        var e = events[i];

                        <li class="rs-events-row" style="--tone: @tones[i % tones.Length];" data-rs-reveal data-rs-vhs>
                            <div class="rs-events-date">
                                <strong>@e.Date.ToString("dd")</strong>
                                <span>@e.Date.ToString("MMM", CultureInfo.InvariantCulture)</span>
                                <small>@e.Date.ToString("ddd", CultureInfo.InvariantCulture)</small>
                            </div>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@e.Id"
                               class="rs-vhs rs-events-poster"
                               tabindex="-1"
                               aria-hidden="true">
                                <span class="rs-vhs-osd rs-vhs-osd--play">&#9654;</span>
                                @if (!string.IsNullOrWhiteSpace(e.ImageUrl))
                                {
                                    <img src="@e.ImageUrl" alt="" loading="lazy" draggable="false" />
                                }
                                else
                                {
                                    <span class="rs-events-placeholder">
                                        <svg viewBox="0 0 100 100"><use href="#rs-bolt" /></svg>
                                        No poster. Still a good night.
                                    </span>
                                }
                            </a>

                            <div class="rs-events-copy">
                                <span class="rs-label">
                                    @FormatEventDate(e.Date)
                                    @if (e.StartTime.HasValue)
                                    {
                                        <text> · @FormatTime(e.StartTime.Value)</text>
                                    }
                                </span>

                                <h3>
                                    <a asp-controller="Events"
                                       asp-action="Details"
                                       asp-route-id="@e.Id">@e.Title</a>
                                </h3>

                                <p>
                                    @(string.IsNullOrWhiteSpace(e.Description)
                                        ? "One more reason to cancel your quiet night at home."
                                        : e.Description)
                                </p>

                                <span class="rs-events-meta">
                                    @e.Date.ToString("dddd, dd MMMM yyyy", CultureInfo.InvariantCulture)
                                </span>
                            </div>

                            <div class="rs-events-actions">
                                <a asp-controller="Reservations"
                                   asp-action="Create"
                                   asp-route-eventId="@e.Id"
                                   class="rs-btn rs-btn--small rs-events-reserve">
                                    Reserve a table
                                </a>

                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@e.Id"
                                   class="rs-btn rs-btn--small rs-btn--ghost">
                                    View event <i aria-hidden="true">&nearr;</i>
                                </a>
                            </div>
                        </li>
                    }
                </ol>
            }
            else
            {
                <div class="rs-events-empty">
                    <span class="rs-kicker">Currently quiet</span>
                    <h3 class="rs-display rs-display--sm">No upcoming events right now.</h3>
                    <p>
                        The speakers are resting, but not for long.
                        Check back soon for new nights, live sets and special events.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="rs-btn rs-btn--ghost">
                        Back to the pub
                    </a>
                </div>
            }
        </div>
    </section>

    <section class="rs-chapter rs-chapter--gold rs-torn rs-events-cta">
        <svg class="rs-events-cta-tape" viewBox="0 0 100 100" aria-hidden="true" data-rs-drift="-0.1"><use href="#rs-tape" /></svg>
        <div class="rs-container rs-events-cta-inner">
            <div>
                <span class="rs-label">Walk-ins are brave.</span>
                <h2 class="rs-display rs-display--lg">Reservations<br />are smarter.</h2>
            </div>

            <a asp-controller="Reservations"
               asp-action="Create"
               class="rs-btn rs-btn--night">
                Reserve a table <i aria-hidden="true">&rarr;</i>
            </a>
        </div>
    </section>

</section>
