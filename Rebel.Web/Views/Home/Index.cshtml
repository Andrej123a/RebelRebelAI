        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.16em;
        margin: 8px 0 0;
        font-family: Impact, "Arial Black", sans-serif;
        font-size: clamp(4.8rem, 9vw, 8.8rem);
        line-height: 0.82;
        font-weight: 900;
        letter-spacing: -0.035em;
