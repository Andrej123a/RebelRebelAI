        --rr-noise-red: #e5232f;
        --rr-noise-ink: #070707;
        position: relative;
        padding: 112px 0 125px;
        overflow: hidden;
        color: #f4f1e9;
        background: radial-gradient(circle at 87% 35%, rgba(229, 35, 47, 0.16), transparent 27%), linear-gradient(180deg, #090909 0%, #050505 100%);
        isolation: isolate;
    }

        .rr-noise-section::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            opacity: 0.34;
            background: repeating-linear-gradient( 94deg, transparent 0, transparent 38px, rgba(255, 255, 255, 0.025) 39px, transparent 40px );
            pointer-events: none;
        }

        .rr-noise-section::after {
            content: "";
            position: absolute;
            right: -8%;
            bottom: 7%;
            z-index: -1;
            width: 42%;
            height: 42%;
            background: rgba(229, 35, 47, 0.08);
            filter: blur(95px);
            transform: rotate(-12deg);
            pointer-events: none;
        }

    .rr-noise-shell {
        position: relative;
        z-index: 2;
    }

    .rr-noise-backword {
        position: absolute;
        top: 40px;
        right: -45px;
        z-index: 0;
        color: transparent;
        font-family: Impact, "Arial Black", sans-serif;
        font-size: clamp(10rem, 23vw, 25rem);
        line-height: 0.8;
        letter-spacing: -0.045em;
        white-space: nowrap;
        -webkit-text-stroke: 1px rgba(255, 255, 255, 0.045);
        transform: rotate(5deg);
        pointer-events: none;
    }

    .rr-noise-heading {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 45px;
        margin-bottom: 66px;
    }

    .rr-noise-heading-copy h2 {
