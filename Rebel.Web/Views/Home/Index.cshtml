            color: var(--rr-noise-yellow);
            font-size: 0.75rem;
            font-weight: 950;
            line-height: 1.4;
            letter-spacing: 0.14em;
        }

    .rr-noise-stamp {
        position: absolute;
        top: 47%;
        right: -11px;
        z-index: 6;
        padding: 12px 17px 11px;
        color: #ffffff;
        background: var(--rr-noise-red);
        font-family: Impact, "Arial Black", sans-serif;
        font-size: 1.1rem;
        line-height: 0.83;
        letter-spacing: 0.05em;
