@model Rebel.Web.Models.HomeViewModel

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Home";

    var featuredEvent = Model.FeaturedEvent;
    var showDrinks = Configuration.GetValue<bool>("Menu:ShowDrinks");
    var hideAiFeatures = bool.TryParse(Configuration["Presentation:HideAiFeatures"], out var hideAi) && hideAi;
}

@functions {
    public DateTime GetSkopjeDate(DateTime date)
    {
        var timeZone =
            TimeZoneInfo.FindSystemTimeZoneById("Europe/Skopje");

        var utcDate = date.Kind == DateTimeKind.Utc
            ? date
            : DateTime.SpecifyKind(date, DateTimeKind.Utc);

        return TimeZoneInfo
            .ConvertTimeFromUtc(utcDate, timeZone)
            .Date;
    }

    public string FormatEventDate(DateTime date)
    {
        var timeZone =
            TimeZoneInfo.FindSystemTimeZoneById("Europe/Skopje");

        var today = TimeZoneInfo
            .ConvertTimeFromUtc(DateTime.UtcNow, timeZone)
            .Date;

        var eventDate = GetSkopjeDate(date);

        if (eventDate == today)
        {
            return "Tonight";
        }

        if (eventDate == today.AddDays(1))
        {
            return "Tomorrow";
        }

        if (eventDate > today &&
            eventDate <= today.AddDays(7))
        {
            return $"This {eventDate:dddd}";
        }

        return eventDate.ToString("dd MMM yyyy");
    }

}

<div class="rs-home">

    <section class="rs-chapter rs-chapter--sky rs-hero" data-rs-stardust>
        <span class="rs-stars rs-hero-stars"></span>


        <div class="rs-container rs-hero-grid">
            <h1 class="rs-hero-title" aria-label="Meet the Rebels">
                <span class="rs-hero-meet" aria-hidden="true">Meet the</span>
                <span class="rs-hero-rebels" aria-hidden="true">Rebels</span>
            </h1>

            <figure class="rs-hero-mural" data-rs-reveal>
                <span class="rs-split rs-hero-mural-frame">
                    <img src="~/images/rebel-bowie-mural.webp"
                         alt="David Bowie portrait, the signature image of Rebel Rebel" />
                    <img src="~/images/rebel-bowie-mural.webp" alt="" aria-hidden="true" />
                </span>
            </figure>

            <div class="rs-hero-copy">
                <p class="rs-lead">
                    Rebel Rebel by Fat Kitchen is a small alternative pub in
                    Skopje, opened in May 2025 for people who wanted something
                    warmer, stranger and more personal than another polished bar.
                </p>

                <p class="rs-hero-more">
                    It is built around good music, casual tables, honest food
                    and the feeling that the place has already lived a little.
                </p>

                <p class="rs-hero-more">
                    <strong>Inspired by Bowie.</strong>
                    He is more than a picture on our wall. Bowie gave Rebel
                    Rebel its name and its spirit: curious, bold and never
                    too interested in fitting neatly into one box.
                </p>

                @* Ask the ones who look after it: Major Tom for a table, Life on Mars? for the food. *@
                <div class="rs-egos rs-home-actions">
                    <partial name="_Ego" model="BowieCalls.Book(Url)" />
                    <partial name="_Ego" model="BowieCalls.Food(Url)" />
                </div>
            </div>
        </div>
    </section>

    @* How Rebel works, one part at a time while you scroll, each looked after by one of
       Bowie's characters (the pub is named after his song), standing in front of a real
       photo of that part. Without JS, or with less motion, it is a plain list. *@
    <section class="rs-chapter rs-changes" id="changes" aria-labelledby="rs-changes-title" data-rs-changes style="--looks: @BowieCast.All.Count;">
        <div class="rs-changes-stage">
            <header class="rs-changes-head">
                <h2 id="rs-changes-title" class="rs-changes-title">How Rebel works</h2>
                <p class="rs-changes-lead">We are named after a Bowie song, so his characters help out around here.</p>
            </header>

            @* Now and then a flying saucer crosses the stage. *@
            <img class="rs-stage-ufo" src="~/art/ufo.webp" asp-append-version="true" width="300" height="170" alt="" aria-hidden="true" decoding="async" />

            <ol class="rs-changes-list">
                @for (var i = 0; i < BowieCast.All.Count; i++)
                {
                    var look = BowieCast.All[i];
                    var job = look.Job;
                    var role = look.Role;
                    var line = look.Line;

                    if (look.Key == "prophet" && hideAiFeatures)
                    {
                        job = "Last call";
                        role = "turns the lights down";
                        line = "Last orders at 01:00, every night.";
                    }

                    <li class="rs-changes-look rs-changes-look--@look.Key"
                        id="look-@look.Key"
                        style="--look-stage: @look.Stage; --look-hot: @look.Hot;"
                        data-rs-look>
                        <div class="rs-changes-back">
                            <partial name="_Photo" model='new PhotoModel(look.Key, Sizes: "(max-width: 760px) 100vw, 66vw")' />
                        </div>

                        <div class="rs-changes-art">
                            @* The figure is the painting's own box, so its effects can sit on it:
                               Aladdin Sane's bolt catches like lightning, the Duke's cigarette smokes. *@
                            <span class="rs-changes-figure">
                                <partial name="_Look" model='new LookModel(look.Key)' />
                                @if (look.Key == "sane")
                                {
                                    <span class="rs-fx-bolt" aria-hidden="true"></span>
                                }
                                else if (look.Key == "duke")
                                {
                                    <span class="rs-fx-smoke" aria-hidden="true"><i></i><i></i><i></i></span>
                                }
                            </span>
                        </div>

                        <div class="rs-changes-copy">
                            <h3 class="rs-changes-job">@job</h3>
                            <p class="rs-changes-who"><b>@look.Name</b> @role</p>
                            @* He says it himself, and what you can say back is the way in. *@
                            @{
                                List<EgoReply> replies = look.Key switch
                                {
                                    "tom" => [new("Book a table", Url.Action("Create", "Reservations")), new("Find my booking", Url.Action("Lookup", "Reservations"))],
                                    "mars" => [new("See the food", Url.Action("Menu", "Home", new { section = "food" }))],
                                    "ziggy" => [new("See the beers", Url.Action("Menu", "Home", new { section = "beer" }))],
                                    "sane" => [new("See the room", "#the-room")],
                                    "duke" => [new("Get directions", BowieCalls.Directions, External: true)],
                                    "pierrot" => [new("See all events", Url.Action("Index", "Events"))],
                                    _ => [],
                                };
                                var asks = look.Key == "prophet" && !hideAiFeatures;
                            }

                            <div class="rs-changes-desk">
                                @if (asks)
                                {
                                    <form class="rs-changes-ask" asp-controller="BeerGuide" asp-action="Index" method="get">
                                        <label class="rs-changes-order-label" for="rs-changes-ask-input">Ask Rebel AI</label>
                                        <input id="rs-changes-ask-input" name="prompt" type="text" maxlength="400" placeholder="Something cold, a bit fruity, not too strong" />
                                        <partial name="_Ego" model='new EgoCall(look.Key, line, [new("Ask")], "rs-ego--says rs-changes-says", Button: "submit")' />
                                    </form>
                                }
                                else
                                {
                                    <partial name="_Ego" model='new EgoCall(look.Key, line, replies, "rs-ego--says rs-changes-says")' />
                                }

                                @if (look.Key == "pierrot" && featuredEvent != null)
                                {
                                    <a class="rs-changes-order" asp-controller="Events" asp-action="Details" asp-route-id="@featuredEvent.Id">
                                        <span class="rs-changes-order-label">Next night</span>
                                        <strong>@featuredEvent.Title</strong>
                                        <span>@FormatEventDate(featuredEvent.Date)@(featuredEvent.StartTime.HasValue ? " · " + featuredEvent.StartTime.Value.ToString(@"hh\:mm") : "")</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ol>
        </div>
    </section>

    <section class="rs-chapter rs-chapter--sky rs-torn rs-home-gallery" id="the-room">

        <div class="rs-container">
            <header class="rs-heading" data-rs-reveal>
                <div>
                    <h2 class="rs-display rs-display--lg">The room</h2>
                </div>

                <p>
                    The Bowie murals, the Liquid Cocaine wall, the hand-made Bowie
                    head at the bar and a light-blue Yugo parked outside.
                </p>
            </header>

            <div class="rs-home-gallery-grid">
                <figure class="rs-bw rs-home-gallery-item rs-home-gallery-one" data-rs-reveal>
                    <img src="~/images/rebel-exterior-yugo-night.webp"
                         alt="Rebel Rebel in Skopje on a rainy night, with a light-blue Yugo parked outside" />
                </figure>

                <figure class="rs-bw rs-home-gallery-item rs-home-gallery-two" data-rs-reveal>
                    <img src="~/images/rebel-bowie-logo-room.webp"
                         alt="The Bowie mural and Rebel Rebel wall inside the Skopje pub" />
                </figure>

                <figure class="rs-bw rs-home-gallery-item rs-home-gallery-card" data-rs-reveal>
                    <img src="~/images/rebel-beers-bowie-sculpture.webp"
                         alt="The hand-made Bowie head on the bar at Rebel Rebel, beside four craft beer cans" />
                </figure>

                <figure class="rs-bw rs-home-gallery-item rs-home-gallery-three" data-rs-reveal>
                    <img src="~/images/rebel-liquid-cocaine-mural-room.webp"
                         alt="The Liquid Cocaine beer mural and seating inside Rebel Rebel" />
                </figure>
            </div>
        </div>
    </section>

    <section class="rs-chapter rs-chapter--sky rs-torn rs-home-menu">

        <partial name="_Photo" model='new PhotoModel("station", "rs-home-station", "(max-width: 760px) 90vw, 50vw")' />

        <div class="rs-container">
            <header class="rs-heading" data-rs-reveal>
                <div>
                    <h2 class="rs-display rs-display--lg">Pick your poison.</h2>
                </div>
            </header>

            @* The menus, carried by the characters who look after them: each holds up a
               picture of what is on it, fingers curled over the frame. *@
            <div class="rs-carriers @(showDrinks ? "rs-carriers--three" : "")">
                <a asp-controller="Home"
                   asp-action="Menu"
                   asp-route-section="food"
                   class="rs-carrier rs-carrier--mars"
                   aria-label="See the food (Life on Mars?)"
                   style="--ego-stage: @BowieCast.For("mars").Stage; --ego-hot: @BowieCast.For("mars").Hot;"
                   data-rs-reveal>
                    <span class="rs-carrier-stage" aria-hidden="true">
                        <img class="rs-carrier-look" src="~/art/looks/mars.webp" asp-append-version="true" width="400" height="520" alt="" loading="lazy" />
                        <span class="rs-carrier-picture">
                            <span class="rs-carrier-photos rs-home-rotator">
                                <img src="https://imageproxy.wolt.com/assets/6a02e61c938b4b58b5c33754?w=960" alt="" />
                                <img src="https://imageproxy.wolt.com/assets/6a03117d3f815eb3031bd7ba?w=960" alt="" />
                                <img src="https://imageproxy.wolt.com/assets/6a02e63b938b4b58b5c33760?w=960" alt="" />
                                <img src="https://imageproxy.wolt.com/assets/6a02e5bc95fd7fae364fccb1?w=960" alt="" />
                            </span>
                            <img class="rs-carrier-hands" src="~/art/hands/mars.webp" asp-append-version="true" width="1000" height="150" alt="" loading="lazy" />
                        </span>
                    </span>
                    <partial name="_Ego" model='new EgoCall("mars", "Food with bad intentions: wings, burgers, pizza and finger food.", [new("See the food")], "rs-carrier-says", Inline: true)' />
                </a>

                <a asp-controller="Home"
                   asp-action="Menu"
                   asp-route-section="beer"
                   class="rs-carrier rs-carrier--ziggy"
                   aria-label="See the beers (Ziggy Stardust)"
                   style="--ego-stage: @BowieCast.For("ziggy").Stage; --ego-hot: @BowieCast.For("ziggy").Hot;"
                   data-rs-reveal>
                    <span class="rs-carrier-stage" aria-hidden="true">
                        <img class="rs-carrier-look" src="~/art/looks/ziggy.webp" asp-append-version="true" width="400" height="520" alt="" loading="lazy" />
                        <span class="rs-carrier-picture">
                            <span class="rs-carrier-photos rs-home-rotator">
                                <img src="https://imageproxy.wolt.com/assets/699da1e53eb3341f036f3ee9?w=960;fit=crop&amp;w=1200&amp;q=85" alt="" />
                                <img src="https://imageproxy.wolt.com/assets/686e194a9aa298f40fedbf30?w=960;fit=crop&amp;w=1200&amp;q=85" alt="" />
                                <img src="https://imageproxy.wolt.com/assets/686e194a9aa298f40fedbf40?w=960;fit=crop&amp;w=1200&amp;q=85" alt="" />
                                <img src="https://imageproxy.wolt.com/assets/686e194a9aa298f40fedbf39?w=960;fit=crop&amp;w=1200&amp;q=85" alt="" />
                            </span>
                            <img class="rs-carrier-hands" src="~/art/hands/ziggy.webp" asp-append-version="true" width="1000" height="150" alt="" loading="lazy" />
                        </span>
                    </span>
                    <partial name="_Ego" model='new EgoCall("ziggy", "Beer beyond the usual: bottles, draft and rare finds.", [new("See the beers")], "rs-carrier-says", Inline: true)' />
                </a>

                @if (showDrinks)
                {
                    <a asp-controller="Home"
                       asp-action="Menu"
                       asp-route-section="drink"
                       class="rs-carrier rs-carrier--jack"
                       aria-label="See the drinks (Halloween Jack)"
                       style="--ego-stage: @BowieCast.For("jack").Stage; --ego-hot: @BowieCast.For("jack").Hot;"
                       data-rs-reveal>
                        <span class="rs-carrier-stage" aria-hidden="true">
                            <img class="rs-carrier-look" src="~/art/looks/jack.webp" asp-append-version="true" width="400" height="520" alt="" loading="lazy" />
                            <span class="rs-carrier-picture">
                                <span class="rs-carrier-photos rs-home-rotator">
                                    <img src="~/images/rebel-liquid-cocaine-mural-room.webp" alt="" />
                                </span>
                                <img class="rs-carrier-hands" src="~/art/hands/jack.webp" asp-append-version="true" width="1000" height="150" alt="" loading="lazy" />
                            </span>
                        </span>
                        <partial name="_Ego" model='new EgoCall("jack", "Liquid courage: spirits, cocktails and shots, till one.", [new("See the drinks")], "rs-carrier-says", Inline: true)' />
                    </a>
                }
            </div>
        </div>
    </section>

</div>
