            <path class="rs-constellation-grid" d="M-60 330A380 380 0 0 1 330 -40" />
            <path class="rs-constellation-grid" d="M0 450A330 330 0 0 1 330 60" />
            <path class="rs-constellation-grid rs-constellation-grid--ra" d="M150 -10L120 450M262 -10L246 450" />
            <polyline class="rs-constellation-line" points="226,22 122,204 214,198 66,414" pathLength="1" />
            <polyline class="rs-constellation-line rs-constellation-line--faint" points="226,22 282,92 214,198" pathLength="1" />
            <g class="rs-constellation-stars">
                <circle cx="226" cy="22" r="3.6" />
                <circle cx="122" cy="204" r="2.6" />
                <circle cx="214" cy="198" r="3" />
                <circle cx="66" cy="414" r="4" />
                <circle cx="282" cy="92" r="1.8" />
                <circle class="rs-constellation-dim" cx="170" cy="110" r="1.2" />
                <circle class="rs-constellation-dim" cx="40" cy="300" r="1" />
                <circle class="rs-constellation-dim" cx="268" cy="300" r="1.3" />
                <circle class="rs-constellation-dim" cx="98" cy="70" r="1" />
            </g>
