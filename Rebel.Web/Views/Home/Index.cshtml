    @* How Rebel works, one part at a time while you scroll, each looked after by one of
       Bowie's characters (the pub is named after his song). Without JS, or with less
       motion, it is a plain list. *@
    <section class="rs-chapter rs-changes" id="changes" aria-labelledby="rs-changes-title" data-rs-changes style="--looks: @BowieCast.All.Count;">
        <div class="rs-changes-stage">
            <header class="rs-changes-head">
                <p class="rs-kicker">Rebel, start to finish</p>
                <h2 id="rs-changes-title" class="rs-changes-title">How Rebel works, in nine&nbsp;changes.</h2>
                <p class="rs-changes-lead">We are named after a Bowie song, so his characters help out around here. Keep scrolling: each one looks after a part of the pub.</p>
            </header>

            <ol class="rs-changes-list">
                @for (var i = 0; i < BowieCast.All.Count; i++)
                {
                    var look = BowieCast.All[i];
                    var job = look.Job;
                    var role = look.Role;
                    var line = look.Line;

                    if (look.Key == "prophet" && hideAiFeatures)
                    {
                        job = "Last call";
                        role = "turns the lights down";
                        line = "Last orders at one in the morning, every night. Finish your drink, the sun is coming up somewhere.";
                    }

                    <li class="rs-changes-look rs-changes-look--@look.Key"
                        id="look-@look.Key"
                        style="--look-stage: @look.Stage; --look-ink: @look.Ink; --look-hot: @look.Hot;"
                        data-rs-look>
                        <div class="rs-changes-back" aria-hidden="true">
                            @switch (look.Backdrop)
                            {
                                case "earth":
                                    <div class="rs-earth"><i></i></div>
                                    break;
                                case "mars":
                                    <div class="rs-mars"></div>
                                    break;
                            }
                        </div>

                        <div class="rs-changes-art">
                            <partial name="_Look" model='new LookModel(look.Key, "changes")' />
                        </div>

                        <div class="rs-changes-copy">
                            <span class="rs-changes-num" aria-hidden="true">@((i + 1).ToString("00"))</span>
                            <h3 class="rs-changes-job">@job</h3>
                            <p class="rs-changes-who"><b>@look.Name</b> @role</p>
                            <p class="rs-changes-line">@line</p>

                            @* His desk: what he looks after here, live from the bar, and where it leads. *@
                            <div class="rs-changes-desk">
                                @switch (look.Key)
                                {
                                    case "tom":
                                        if (Model.Picks.TryGetValue("tom", out var tomBeer))
                                        {
                                            <a class="rs-changes-order" href="@BeerTrackUrl(tomBeer)">
                                                <span class="rs-changes-order-label">His drink</span>
                                                <strong>@tomBeer.Name</strong>
                                                <span>@(string.Join(" · ", new[] { tomBeer.BeerStyle, tomBeer.AlcoholByVolume is { } abv ? $"{abv:0.#}%" : null, tomBeer.OriginCountry }.Where(part => !string.IsNullOrWhiteSpace(part))))</span>
                                                <b>@tomBeer.Price.ToString("0.##")<small>ден</small></b>
                                            </a>
                                        }

                                        <div class="rs-changes-actions">
                                            <a asp-controller="Reservations" asp-action="Create" class="rs-btn rs-btn--primary">Book a table <i aria-hidden="true">&rarr;</i></a>
                                            <a asp-controller="Reservations" asp-action="Lookup" class="rs-btn rs-btn--ghost">Find my booking</a>
                                        </div>
                                        break;

                                    case "mars":
                                        if (Model.DishOfTheDay is { } dish)
                                        {
                                            <a class="rs-changes-order" asp-controller="Home" asp-action="Menu" asp-route-section="food">
                                                <span class="rs-changes-order-label">Today he's having</span>
                                                <strong>@dish.Name</strong>
                                                <span>@(dish.Category?.Name)</span>
                                                <b>@dish.Price.ToString("0.##")<small>ден</small></b>
                                            </a>
                                        }

                                        <div class="rs-changes-actions">
                                            <a asp-controller="Home" asp-action="Menu" asp-route-section="food" class="rs-btn rs-btn--primary">See the food <i aria-hidden="true">&rarr;</i></a>
                                        </div>
                                        break;

                                    case "ziggy":
                                        if (Model.Picks.TryGetValue("ziggy", out var ziggyBeer))
                                        {
                                            <a class="rs-changes-order" href="@BeerTrackUrl(ziggyBeer)">
                                                <span class="rs-changes-order-label">His drink</span>
                                                <strong>@ziggyBeer.Name</strong>
                                                <span>@(string.Join(" · ", new[] { ziggyBeer.BeerStyle, ziggyBeer.AlcoholByVolume is { } abv ? $"{abv:0.#}%" : null, ziggyBeer.OriginCountry }.Where(part => !string.IsNullOrWhiteSpace(part))))</span>
                                                <b>@ziggyBeer.Price.ToString("0.##")<small>ден</small></b>
                                            </a>
                                        }

                                        <div class="rs-changes-actions">
                                            <a asp-controller="Home" asp-action="Menu" asp-route-section="beer" class="rs-btn rs-btn--primary">Play the beer tracklist <i aria-hidden="true">&rarr;</i></a>
                                        </div>
                                        break;

                                    case "sane":
                                        <div class="rs-changes-actions">
                                            <a href="#the-room" class="rs-btn rs-btn--primary">See the room <i aria-hidden="true">&darr;</i></a>
                                        </div>
                                        break;

                                    case "rebel":
                                        <dl class="rs-changes-facts">
                                            <div><dt>Since</dt><dd>May 2025</dd></div>
                                            <div><dt>Where</dt><dd>Skopje</dd></div>
                                            <div><dt>Kitchen</dt><dd>Fat Kitchen</dd></div>
                                        </dl>
                                        break;

                                    case "jack":
                                        <dl class="rs-changes-facts">
                                            <div><dt>Open</dt><dd>12:00</dd></div>
                                            <div><dt>Close</dt><dd>01:00</dd></div>
                                            <div><dt>Days</dt><dd>Every one</dd></div>
                                        </dl>

                                        <div class="rs-changes-actions">
                                            <a asp-controller="Home" asp-action="Contact" class="rs-btn rs-btn--ghost">Hours &amp; contact</a>
                                        </div>
                                        break;

                                    case "duke":
                                        <div class="rs-changes-actions">
                                            <a href="https://www.google.com/maps/search/?api=1&amp;query=Naum+Naumovski+Borce+62+Skopje" class="rs-btn rs-btn--primary" target="_blank" rel="noopener">Open directions <i aria-hidden="true">&nearr;</i></a>
                                            <a asp-controller="Home" asp-action="Contact" class="rs-btn rs-btn--ghost">Contact</a>
                                        </div>
                                        break;

                                    case "pierrot":
                                        if (featuredEvent != null)
                                        {
                                            <a class="rs-changes-order" asp-controller="Events" asp-action="Details" asp-route-id="@featuredEvent.Id">
                                                <span class="rs-changes-order-label">Next on tape</span>
                                                <strong>@featuredEvent.Title</strong>
                                                <span>@FormatEventDate(featuredEvent.Date)@(featuredEvent.StartTime.HasValue ? " · " + featuredEvent.StartTime.Value.ToString(@"hh\:mm") : "")</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <p class="rs-changes-order rs-changes-order--empty">
                                                <span class="rs-changes-order-label">Next on tape</span>
                                                <strong>No tape in the machine yet.</strong>
                                                <span>New nights are on the way.</span>
                                            </p>
                                        }

                                        <div class="rs-changes-actions">
                                            <a asp-controller="Events" asp-action="Index" class="rs-btn rs-btn--primary">See the lineup <i aria-hidden="true">&rarr;</i></a>
                                        </div>
                                        break;

                                    case "prophet":
                                        if (!hideAiFeatures)
                                        {
                                            <form class="rs-changes-ask" asp-controller="BeerGuide" asp-action="Index" method="get">
                                                <label class="rs-changes-order-label" for="rs-changes-ask-input">Tell the Prophet</label>
                                                <input id="rs-changes-ask-input" name="prompt" type="text" maxlength="400" placeholder="Something cold, a bit fruity, not too strong" />
                                                <button type="submit" class="rs-btn rs-btn--primary">Ask him <i aria-hidden="true">&rarr;</i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="rs-changes-actions">
                                                <a asp-controller="Reservations" asp-action="Create" class="rs-btn rs-btn--primary">Book a table <i aria-hidden="true">&rarr;</i></a>
                                            </div>
                                        }
                                        break;
                                }
                            </div>
                        </div>
                    </li>
                }
            </ol>

            <nav class="rs-changes-roll" aria-label="How Rebel works">
                @for (var i = 0; i < BowieCast.All.Count; i++)
                {
                    var look = BowieCast.All[i];

                    <a href="#look-@look.Key" data-rs-roll="@i">
                        <b>@((i + 1).ToString("00"))</b>
                        <span>@(look.Key == "prophet" && hideAiFeatures ? "Last call" : look.Job)</span>
                    </a>
                }
            </nav>

            <span class="rs-changes-count" aria-hidden="true"><b data-rs-changes-now>01</b> / @BowieCast.All.Count.ToString("00")</span>
        </div>
    </section>

