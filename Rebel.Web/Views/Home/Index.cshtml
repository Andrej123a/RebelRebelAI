        }

        .rr-noise-type.rr-type-special {
            color: #ffffff;
            background: #6d45cb;
        }

        .rr-noise-type.rr-type-acoustic {
            background: #e6ded0;
        }

    .rr-noise-date {
        position: absolute;
        top: 25px;
        right: 34px;
        z-index: 6;
        display: flex;
        align-items: flex-end;
        gap: 12px;
        color: #ffffff;
        text-shadow: 0 5px 24px rgba(0, 0, 0, 0.5);
        transform: rotate(1.5deg);
    }

        .rr-noise-date strong {
            font-family: Impact, "Arial Black", sans-serif;
            font-size: clamp(5.5rem, 9vw, 9rem);
            line-height: 0.78;
            letter-spacing: -0.045em;
        }

        .rr-noise-date span {
