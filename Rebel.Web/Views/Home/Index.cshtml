    <div class="rs-tapes" aria-hidden="true">
        <div class="rs-marquee">
            <div class="rs-marquee-track">
                @for (var copy = 0; copy < 2; copy++)
                {
                    <div class="rs-marquee-group">
                        <span class="rs-marquee-item">Cold beer<small>50+</small></span>
                        <span class="rs-marquee-item">Fat Kitchen food</span>
                        <span class="rs-marquee-item">Loud records</span>
                        <span class="rs-marquee-item">Live nights</span>
                        <span class="rs-marquee-item">Open every day<small>12&ndash;01</small></span>
                        <span class="rs-marquee-item">Naum Naumovski Borce 62</span>
                        <span class="rs-marquee-item">Rebel Rebel<small>since &rsquo;25</small></span>
                    </div>
                }
            </div>
        </div>
