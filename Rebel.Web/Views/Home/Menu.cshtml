@using Rebel.Domain.Enums
@using Rebel.Web.Services
@model List<Rebel.Domain.Entities.Product>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Menu";

    var hideAiFeatures = Configuration.GetValue<bool>(
        "Presentation:HideAiFeatures");
    var showDrinksMenu = Configuration.GetValue<bool>(
        "Menu:ShowDrinks");

    var selectedSection = (ViewBag.Section as string ?? "food").ToLower();

    if (selectedSection != "food" &&
        selectedSection != "beer" &&
        !(showDrinksMenu && selectedSection == "drink"))
    {
        selectedSection = "food";
    }

    var selectedType = selectedSection switch
    {
        "beer" => CategoryType.Beer,
        "drink" => CategoryType.Drink,
        _ => CategoryType.Food
    };

    var sectionTitle = selectedSection switch
    {
        "beer" => "Beer Menu",
        "drink" => "Drinks Menu",
        _ => "Food Menu"
    };

    var sectionMessage = selectedSection switch
    {
        "beer" => "Cold bottles, fresh pours and zero bad decisions.",
        "drink" => "Pick your poison. We are not here to judge.",
        _ => "Messy hands. Full stomach. No regrets."
    };

    var rail = selectedSection switch
    {
        "beer" => new RailModel("02", "The fridge"),
        "drink" => new RailModel("02", "The bar"),
        _ => new RailModel("02", "The kitchen")
    };

    var (titleTop, titleBottom) = selectedSection switch
    {
        "beer" => ("The beers", "from Mars"),
        "drink" => ("Liquid", "courage"),
        _ => ("Food with", "bad intentions")
    };

    // Who stands in the hero: Life on Mars? over the food, Ziggy over the beer.
    var heroLook = selectedSection switch
    {
        "beer" => "ziggy",
        "drink" => null,
        _ => "mars"
    };

    var heroIcon = selectedSection switch
    {
        "beer" => "star",
        "drink" => null,
        _ => "planet"
    };

    var menuGroups = Model
        .Where(p => p.Category != null && p.Category.Type == selectedType)
        .GroupBy(p => p.Category!.Name)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="rs-menu-page@(selectedSection == "beer" ? " rr-menu-page--beer" : "")">

    <header class="rs-chapter rs-chapter--sky rs-menu-hero" data-rs-stardust>
        <span class="rs-stars rs-menu-stars"></span>

        <partial name="_Rail" model="rail" />

        <partial name="_Hud" />

        @if (heroIcon == "planet")
        {
            <div class="rs-mars rs-menu-mars" aria-hidden="true" data-rs-drift="-0.1"></div>
        }
        else if (heroIcon == "star")
        {
            <div class="rs-starman rs-menu-starman" aria-hidden="true" data-rs-drift="-0.1"></div>
        }

        @if (heroLook != null)
        {
            <partial name="_Look" model='new LookModel(heroLook, "hero", "rs-page-look rs-page-look--menu")' />

            @* What he orders: today's dish for Life on Mars?, his astronaut beer for Ziggy. *@
            var skopjeToday = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("Europe/Skopje"));

            if (heroLook == "mars" && BowieCast.DishOfTheDay(Model, skopjeToday) is { } dish)
            {
                <a class="rs-look-tag rs-look-tag--menu" href="#dish-@dish.Id">
                    <b>Today he's having</b> @dish.Name <i aria-hidden="true">&darr;</i>
                </a>
            }
            else if (heroLook == "ziggy" && BowieCast.FindPick(Model, "ziggy") is { } ziggyBeer)
            {
                <a class="rs-look-tag rs-look-tag--menu" href="#@(BeerMenuPresenter.CreateAnchor(ziggyBeer.Name, 0, new HashSet<string>()))">
                    <b>Ziggy's pick</b> @ziggyBeer.Name <i aria-hidden="true">&darr;</i>
                </a>
            }
        }

        <div class="rs-container rs-menu-hero-inner">
            <div>
                <h1 class="rs-display rs-display--xl" aria-label="@titleTop @titleBottom">
                    @titleTop <span class="rs-accent">@titleBottom</span>
                </h1>

                <p class="rs-lead">Come hungry. Leave louder.</p>
            </div>

            <partial name="_RebelBadge" model='new RebelBadgeModel("rs-menu-badge", "EST. SKOPJE // FOOD // BEER // LOUD NIGHTS // ", "rs-menu-badge")' />
        </div>

        <nav class="rs-container rs-menu-tabs" aria-label="Menu sections">
            <a asp-controller="Home"
               asp-action="Menu"
               asp-route-section="food"
               class="rs-menu-tab @(selectedSection == "food" ? "is-active" : "")"
               aria-current="@(selectedSection == "food" ? "page" : null)"
               style="--tone: var(--rs-yellow);">
                <span>01</span> Food
            </a>

            <a asp-controller="Home"
               asp-action="Menu"
               asp-route-section="beer"
               class="rs-menu-tab @(selectedSection == "beer" ? "is-active" : "")"
               aria-current="@(selectedSection == "beer" ? "page" : null)"
               style="--tone: var(--rs-yellow);">
                <span>02</span> Beer
            </a>

            @if (showDrinksMenu)
            {
                <a asp-controller="Home"
                   asp-action="Menu"
                   asp-route-section="drink"
                   class="rs-menu-tab @(selectedSection == "drink" ? "is-active" : "")"
                   aria-current="@(selectedSection == "drink" ? "page" : null)"
                   style="--tone: var(--rs-red);">
                    <span>03</span> Drinks
                </a>
            }
        </nav>
    </header>

    @if (selectedSection == "beer")
    {
        <partial name="_BeerMenuStage" model="BeerMenuPresenter.Build(Model)" />
    }
    else
    {
        <div class="rs-container rs-food">
            @* The manifest of what came down from the kitchen, and the courier bringing it. *@
            <header class="rs-manifest">
                <div class="rs-manifest-copy">
                    <p class="rs-manifest-top">
                        <span>Cargo manifest</span>
                        <span>@(selectedSection == "drink" ? "The bar" : "Fat Kitchen") &rarr; your table</span>
                    </p>
                    <h2>@sectionTitle</h2>
                    <p class="rs-manifest-sub">@sectionMessage</p>
                </div>

                <partial name="_Look" model='new LookModel("courier", "manifest", "rs-manifest-courier")' />
            </header>

            <section class="rs-food-tools"
                     aria-label="Menu search and filters">
                <div class="rs-field rs-food-search">
                    <label for="menuSearchInput">Find your order</label>
                    <input id="menuSearchInput"
                           type="search"
                           placeholder="Search burgers, spicy, vegan..."
                           autocomplete="off" />
                </div>

                <div class="rs-food-chips"
                     role="group"
                     aria-label="Menu tag filters">
                    <button type="button" class="rs-chip is-active" aria-pressed="true" data-filter="all">All</button>
                    <button type="button" class="rs-chip" aria-pressed="false" data-filter="available"><i aria-hidden="true"></i>Available</button>
                    <button type="button" class="rs-chip" aria-pressed="false" data-filter="popular"><i aria-hidden="true"></i>Popular</button>
                    <button type="button" class="rs-chip" aria-pressed="false" data-filter="spicy"><i aria-hidden="true"></i>Spicy</button>
                    <button type="button" class="rs-chip" aria-pressed="false" data-filter="sweet"><i aria-hidden="true"></i>Sweet</button>
                    <button type="button" class="rs-chip" aria-pressed="false" data-filter="vegan"><i aria-hidden="true"></i>Vegan</button>
                    <button type="button" class="rs-chip" aria-pressed="false" data-filter="vegetarian"><i aria-hidden="true"></i>Vegetarian</button>
                </div>

                <p id="menuFilterSummary"
                   class="rs-food-summary"
                   aria-live="polite"></p>

                <div id="menuFilterEmpty"
                     class="rs-food-empty"
                     hidden>
                    <strong>No matching menu items.</strong>
                    <span>Try another search or clear the filters.</span>
                    <button type="button"
                            id="menuFilterClear"
                            class="rs-btn rs-btn--small rs-btn--paper">
                        Clear filters
                    </button>
                </div>
            </section>

            @if (!menuGroups.Any())
            {
                <div class="rs-food-nothing">
                    <h3 class="rs-display rs-display--sm">Nothing aboard yet.</h3>
                    <p>This bay is still being loaded. Try the other menus in the meantime.</p>
                </div>
            }
            else
            {
                var categoryNumber = 1;

                @foreach (var group in menuGroups)
                {
                    <section class="rs-food-category"
                             data-menu-category>
                        @* Each category is a cargo bay. *@
                        <header class="rs-bay-head">
                            <span class="rs-bay-num">Bay @categoryNumber.ToString("00")</span>
                            <h3>@group.Key</h3>
                            <span class="rs-bay-count">@group.Count().ToString("00") aboard</span>
                        </header>

                        <div class="rs-food-grid">
                            @foreach (var product in group)
                            {
                                var pairingDescription = string.IsNullOrWhiteSpace(product.Description)
                                    ? null
                                    : product.Description.Trim()[..Math.Min(product.Description.Trim().Length, 180)];
                                var rebelPrompt = selectedType switch
                                {
                                    CategoryType.Food when product.IsAvailable =>
                                        $"I need a beer pairing for {product.Name}." +
                                        (pairingDescription == null
                                            ? ""
                                            : $" The dish is: {pairingDescription}.") +
                                        " Give me three available options.",
                                    _ => null
                                };

                                var searchableText =
                                    $"{product.Name} {product.Description} {group.Key}"
                                        .ToLowerInvariant()
                                        .Replace("\"", string.Empty);

                                var tagData = string.Join(
                                    " ",
                                    new[]
                                    {
                                        product.IsAvailable ? "available" : "unavailable",
                                        product.IsPopular ? "popular" : "",
                                        product.IsSpicy ? "spicy" : "",
                                        product.SweetnessLevel is >= 4 ? "sweet" : "",
                                        product.IsVegetarian ? "vegetarian" : "",
                                        product.IsVegan ? "vegan" : "",
                                        product.ContainsNuts ? "nuts" : "",
                                        product.IsLimited ? "limited" : "",
                                        product.IsPromo ? "promo" : ""
                                    }.Where(tag => !string.IsNullOrWhiteSpace(tag)));

                                <article class="rs-crate @(!product.IsAvailable ? "is-unavailable" : "")"
                                         id="dish-@product.Id"
                                         data-menu-item
                                         data-search="@searchableText"
                                         data-tags="@tagData">
                                    <div class="rs-crate-media">
                                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl"
                                                 alt="@product.Name"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="rs-crate-placeholder" aria-hidden="true">
                                                <span>No photo.<br />Still tastes good.</span>
                                            </div>
                                        }

                                        <span class="rs-crate-price">
                                            @product.Price.ToString("0.##")<small>ден</small>
                                        </span>

                                        @if (!product.IsAvailable)
                                        {
                                            <span class="rs-crate-stamp">Out of stock</span>
                                        }
                                    </div>

                                    <div class="rs-crate-body">
                                        <div class="rs-crate-top">
                                            <span class="rs-label">@group.Key</span>
                                            <span class="rs-crate-status">
                                                <i class="rs-led @(product.IsAvailable ? "" : "rs-led--red")" aria-hidden="true"></i>
                                                @(product.IsAvailable ? "Available" : "Unavailable")
                                            </span>
                                        </div>

                                        <h4>@product.Name</h4>

                                        @if (product.IsPopular || product.IsSpicy || product.SweetnessLevel is >= 4 ||
                                             product.IsVegetarian || product.IsVegan || product.ContainsNuts ||
                                             product.IsLimited || product.IsPromo)
                                        {
                                            <ul class="rs-food-tags" aria-label="Tags">
                                                @if (product.IsPopular)
                                                {
                                                    <li class="rs-pill">Popular</li>
                                                }

                                                @if (product.IsSpicy)
                                                {
                                                    <li class="rs-pill">Spicy</li>
                                                }

                                                @if (product.SweetnessLevel is >= 4)
                                                {
                                                    <li class="rs-pill">Sweet</li>
                                                }

                                                @if (product.IsVegetarian)
                                                {
                                                    <li class="rs-pill">Vegetarian</li>
                                                }

                                                @if (product.IsVegan)
                                                {
                                                    <li class="rs-pill">Vegan</li>
                                                }

                                                @if (product.ContainsNuts)
                                                {
                                                    <li class="rs-pill rs-pill--warning">Contains nuts</li>
                                                }

                                                @if (product.IsLimited)
                                                {
                                                    <li class="rs-pill">Limited</li>
                                                }

                                                @if (product.IsPromo)
                                                {
                                                    <li class="rs-pill">Promo</li>
                                                }
                                            </ul>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(product.Description))
                                        {
                                            <p>@product.Description</p>
                                        }

                                        @if (!hideAiFeatures && !string.IsNullOrWhiteSpace(rebelPrompt))
                                        {
                                            <a asp-controller="BeerGuide"
                                               asp-action="Index"
                                               asp-route-prompt="@rebelPrompt"
                                               class="rs-food-pair">
                                                Find a beer for this <i aria-hidden="true">&rarr;</i>
                                            </a>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>

                    categoryNumber++;
                }
            }
        </div>
    }
</div>

@section Styles {
    @if (selectedSection == "beer")
    {
        <link rel="stylesheet"
              href="~/css/beer-menu.css"
              asp-append-version="true" />
    }
}

@section Scripts {
    @if (selectedSection == "beer")
    {
        <script src="~/js/beer-menu.js" asp-append-version="true"></script>
    }
    else
    {
        <script>
            (() => {
                const searchInput = document.getElementById("menuSearchInput");
                const summary = document.getElementById("menuFilterSummary");
                const emptyState = document.getElementById("menuFilterEmpty");
                const clearButton = document.getElementById("menuFilterClear");
                const chips = Array.from(document.querySelectorAll(".rs-food-chips [data-filter]"));
                const items = Array.from(document.querySelectorAll("[data-menu-item]"));
                const categories = Array.from(document.querySelectorAll("[data-menu-category]"));

                if (!searchInput || !items.length) {
                    return;
                }

                let activeFilter = "all";

                const setActiveChip = (filter) => {
                    activeFilter = filter;

                    chips.forEach((chip) => {
                        const isActive = chip.dataset.filter === filter;
                        chip.classList.toggle("is-active", isActive);
                        chip.setAttribute("aria-pressed", isActive ? "true" : "false");
                    });
                };

                const applyFilters = () => {
                    const query = searchInput.value.trim().toLowerCase();
                    let visibleCount = 0;

                    items.forEach((item) => {
                        const matchesSearch = !query || item.dataset.search.includes(query);
                        const matchesFilter =
                            activeFilter === "all" ||
                            item.dataset.tags.split(" ").includes(activeFilter);
                        const isVisible = matchesSearch && matchesFilter;

                        item.hidden = !isVisible;

                        if (isVisible) {
                            visibleCount++;
                        }
                    });

                    categories.forEach((category) => {
                        category.hidden = category.querySelector("[data-menu-item]:not([hidden])") === null;
                    });

                    if (summary) {
                        summary.textContent = visibleCount === 1
                            ? "1 item found"
                            : `${visibleCount} items found`;
                    }

                    if (emptyState) {
                        emptyState.hidden = visibleCount > 0;
                    }
                };

                chips.forEach((chip) => {
                    chip.addEventListener("click", () => {
                        setActiveChip(chip.dataset.filter ?? "all");
                        applyFilters();
                    });
                });

                searchInput.addEventListener("input", applyFilters);

                clearButton?.addEventListener("click", () => {
                    searchInput.value = "";
                    setActiveChip("all");
                    applyFilters();
                    searchInput.focus();
                });

                applyFilters();
            })();
        </script>
    }
}
