@using Rebel.Domain.Enums
@using Rebel.Web.Services
@model List<Rebel.Domain.Entities.Product>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Menu";

    var hideAiFeatures = Configuration.GetValue<bool>(
        "Presentation:HideAiFeatures");
    var showDrinksMenu = Configuration.GetValue<bool>(
        "Menu:ShowDrinks");

    var selectedSection = (ViewBag.Section as string ?? "food").ToLower();

    if (selectedSection != "food" &&
        selectedSection != "beer" &&
        !(showDrinksMenu && selectedSection == "drink"))
    {
        selectedSection = "food";
    }

    var selectedType = selectedSection switch
    {
        "beer" => CategoryType.Beer,
        "drink" => CategoryType.Drink,
        _ => CategoryType.Food
    };

    var (titleTop, titleBottom) = selectedSection switch
    {
        "beer" => ("The beers", "from Mars"),
        "drink" => ("Liquid", "courage"),
        _ => ("Food with", "bad intentions")
    };

    // Who stands in the hero: Life on Mars? in front of Mars over the food, Ziggy in front of
    // the pub's own cans over the beer.
    var heroLook = selectedSection switch
    {
        "beer" => "ziggy",
        "drink" => null,
        _ => "mars"
    };

    var menuGroups = Model
        .Where(p => p.Category != null && p.Category.Type == selectedType)
        .GroupBy(p => p.Category!.Name)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="rs-menu-page@(selectedSection == "beer" ? " rr-menu-page--beer" : "")">

    <header class="rs-chapter rs-chapter--sky rs-menu-hero" data-rs-stardust>
        <span class="rs-stars rs-menu-stars"></span>

        @if (heroLook != null)
        {
            <partial name="_Photo" model='new PhotoModel(heroLook, "rs-page-photo rs-page-photo--menu", "(max-width: 760px) 100vw, 50vw")' />
            <partial name="_Look" model='new LookModel(heroLook, "rs-page-look rs-page-look--menu")' />
        }

        <div class="rs-container rs-menu-hero-inner">
            <div>
                <h1 class="rs-display rs-display--xl" aria-label="@titleTop @titleBottom">
                    @titleTop <span class="rs-accent">@titleBottom</span>
                </h1>
            </div>
        </div>

        @* Each part of the menu is asked of its character: the kitchen, the beers, the bar. *@
        <nav class="rs-container rs-menu-tabs" aria-label="Menu sections">
            <a asp-controller="Home"
               asp-action="Menu"
               asp-route-section="food"
               class="rs-menu-tab @(selectedSection == "food" ? "is-active" : "")"
               aria-current="@(selectedSection == "food" ? "page" : null)"
               style="--ego-stage: @BowieCast.For("mars").Stage; --ego-hot: @BowieCast.For("mars").Hot;">
                <span class="rs-cast-face" aria-hidden="true"><img src="~/art/faces/mars.webp" asp-append-version="true" width="96" height="96" alt="" /></span>
                <span class="rs-menu-tab-word">Food</span>
                <small>@BowieCast.For("mars").Name</small>
            </a>

            <a asp-controller="Home"
               asp-action="Menu"
               asp-route-section="beer"
               class="rs-menu-tab @(selectedSection == "beer" ? "is-active" : "")"
               aria-current="@(selectedSection == "beer" ? "page" : null)"
               style="--ego-stage: @BowieCast.For("ziggy").Stage; --ego-hot: @BowieCast.For("ziggy").Hot;">
                <span class="rs-cast-face" aria-hidden="true"><img src="~/art/faces/ziggy.webp" asp-append-version="true" width="96" height="96" alt="" /></span>
                <span class="rs-menu-tab-word">Beer</span>
                <small>@BowieCast.For("ziggy").Name</small>
            </a>

            @if (showDrinksMenu)
            {
                <a asp-controller="Home"
                   asp-action="Menu"
                   asp-route-section="drink"
                   class="rs-menu-tab @(selectedSection == "drink" ? "is-active" : "")"
                   aria-current="@(selectedSection == "drink" ? "page" : null)"
                   style="--ego-stage: @BowieCast.For("jack").Stage; --ego-hot: @BowieCast.For("jack").Hot;">
                    <span class="rs-cast-face" aria-hidden="true"><img src="~/art/faces/jack.webp" asp-append-version="true" width="96" height="96" alt="" /></span>
                    <span class="rs-menu-tab-word">Drinks</span>
                    <small>@BowieCast.For("jack").Name</small>
                </a>
            }
        </nav>
    </header>

    @if (selectedSection == "beer")
    {
        <partial name="_BeerMenuStage" model="BeerMenuPresenter.Build(Model)" />
    }
    else
    {
        // The kitchen is Life on Mars?'s (the bar's drinks are Halloween Jack's).
        var host = BowieCast.For(selectedSection == "drink" ? "jack" : "mars");
        var hostOpening = selectedSection == "drink"
            ? "The bar's open till one. What are you drinking?"
            : "Is there life on Mars? There's food. What are you hungry for?";

        @* Below Mars, the white set of his video: the dishes are the prints from the shoot,
           the favourites circled in red grease pencil, and he talks you through them. *@
        <div class="rs-studio rs-studio--@host.Key" style="--host-stage: @host.Stage; --host-hot: @host.Hot;">
            <div class="rs-container rs-studio-inner">
                <div class="rs-studio-main">
                    @* He asks what you are hungry for; the filters are your answers. *@
                    <section class="rs-studio-ask" aria-label="Menu search and filters" hidden="@(!menuGroups.Any())">
                        <span class="rs-ego-face" aria-hidden="true" style="--ego-stage: @host.Stage; --ego-hot: @host.Hot;"><img src="@Url.Content($"~/art/faces/{host.Key}.webp")" asp-append-version="true" width="160" height="160" alt="" /></span>

                        <div class="rs-ego-bubble rs-studio-ask-bubble">
                            <span class="rs-ego-who">@host.Name</span>
                            <label class="rs-ego-line" for="menuSearchInput">@hostOpening</label>
                            <input id="menuSearchInput"
                                   type="search"
                                   placeholder="Burgers, spicy, vegan..."
                                   autocomplete="off" />

                            <div class="rs-food-chips"
                                 role="group"
                                 aria-label="Menu tag filters">
                                <button type="button" class="rs-chip is-active" aria-pressed="true" data-filter="all">All</button>
                                <button type="button" class="rs-chip" aria-pressed="false" data-filter="available">Available</button>
                                <button type="button" class="rs-chip" aria-pressed="false" data-filter="popular">Popular</button>
                                <button type="button" class="rs-chip" aria-pressed="false" data-filter="spicy">Spicy</button>
                                <button type="button" class="rs-chip" aria-pressed="false" data-filter="sweet">Sweet</button>
                                <button type="button" class="rs-chip" aria-pressed="false" data-filter="vegan">Vegan</button>
                                <button type="button" class="rs-chip" aria-pressed="false" data-filter="vegetarian">Vegetarian</button>
                            </div>

                            <p id="menuFilterSummary"
                               class="rs-food-summary"
                               aria-live="polite"></p>
                        </div>
                    </section>

                    <div id="menuFilterEmpty"
                         class="rs-food-empty"
                         hidden>
                        <partial name="_Ego" model='new EgoCall(host.Key, "Nothing like that in the kitchen tonight. Start again?", [new("Clear filters")], "rs-ego--small", Button: "button", Attributes: new Dictionary<string, string> { ["id"] = "menuFilterClear" })' />
                    </div>

                    @if (!menuGroups.Any())
                    {
                        <div class="rs-food-nothing">
                            <h3 class="rs-display rs-display--sm">Nothing on this menu yet.</h3>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in menuGroups)
                        {
                            var count = group.Count();

                            @* Each category is a set from the shoot, its name brushed on in his eyeshadow. *@
                            <section class="rs-studio-set"
                                     data-menu-category
                                     data-rs-set-line="@group.Key: @count on the menu tonight.">
                                <h3 class="rs-studio-title"><span>@group.Key</span></h3>

                                <div class="rs-prints">
                                    @foreach (var product in group)
                                    {
                                        var pairingDescription = string.IsNullOrWhiteSpace(product.Description)
                                            ? null
                                            : product.Description.Trim()[..Math.Min(product.Description.Trim().Length, 180)];
                                        var rebelPrompt = selectedType switch
                                        {
                                            CategoryType.Food when product.IsAvailable =>
                                                $"I need a beer pairing for {product.Name}." +
                                                (pairingDescription == null
                                                    ? ""
                                                    : $" The dish is: {pairingDescription}.") +
                                                " Give me three available options.",
                                            _ => null
                                        };

                                        var searchableText =
                                            $"{product.Name} {product.Description} {group.Key}"
                                                .ToLowerInvariant()
                                                .Replace("\"", string.Empty);

                                        var tagData = string.Join(
                                            " ",
                                            new[]
                                            {
                                                product.IsAvailable ? "available" : "unavailable",
                                                product.IsPopular ? "popular" : "",
                                                product.IsSpicy ? "spicy" : "",
                                                product.SweetnessLevel is >= 4 ? "sweet" : "",
                                                product.IsVegetarian ? "vegetarian" : "",
                                                product.IsVegan ? "vegan" : "",
                                                product.ContainsNuts ? "nuts" : "",
                                                product.IsLimited ? "limited" : "",
                                                product.IsPromo ? "promo" : ""
                                            }.Where(tag => !string.IsNullOrWhiteSpace(tag)));

                                        var notes = new[]
                                        {
                                            product.IsPopular ? "a favourite" : null,
                                            product.IsSpicy ? "spicy" : null,
                                            product.SweetnessLevel is >= 4 ? "sweet" : null,
                                            product.IsVegan ? "vegan" : product.IsVegetarian ? "vegetarian" : null,
                                            product.ContainsNuts ? "contains nuts" : null,
                                            product.IsLimited ? "limited" : null,
                                            product.IsPromo ? "promo" : null,
                                        }.Where(note => note != null).ToList();

                                        var price = product.Price.ToString("0.##");
                                        var hostLine = product.IsAvailable
                                            ? $"{product.Name}, {price} ден. {product.Description}".Trim()
                                            : $"{product.Name} is out tonight.";

                                        <article class="rs-print@(product.IsPopular ? " is-popular" : "")@(!product.IsAvailable ? " is-unavailable" : "")"
                                                 id="dish-@product.Id"
                                                 data-menu-item
                                                 data-search="@searchableText"
                                                 data-tags="@tagData"
                                                 data-rs-host-line="@hostLine">
                                            <figure class="rs-print-photo">
                                                <span class="rs-print-frame">
                                                    <span class="rs-print-window">
                                                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                                        {
                                                            <img src="@product.ImageUrl"
                                                                 alt="@product.Name"
                                                                 loading="lazy" />
                                                        }
                                                        else
                                                        {
                                                            <span class="rs-print-blank" aria-hidden="true"></span>
                                                        }
                                                    </span>

                                                    @if (product.IsPopular)
                                                    {
                                                        <span class="rs-grease rs-grease--circle" aria-hidden="true"></span>
                                                    }

                                                    @if (!product.IsAvailable)
                                                    {
                                                        <span class="rs-grease rs-grease--cross" aria-hidden="true"></span>
                                                        <span class="rs-print-out">Out tonight</span>
                                                    }
                                                </span>

                                                <figcaption>
                                                    <h4>@product.Name</h4>
                                                    <span class="rs-print-price">@price<small>ден</small></span>
                                                </figcaption>
                                            </figure>

                                            @if (notes.Count > 0)
                                            {
                                                <p class="rs-print-notes">@string.Join(" · ", notes)</p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(product.Description))
                                            {
                                                <p class="rs-print-text">@product.Description</p>
                                            }

                                            @if (!hideAiFeatures && !string.IsNullOrWhiteSpace(rebelPrompt))
                                            {
                                                <partial name="_Ego" model='new EgoCall("prophet", "", [new("Find a beer for this", Url.Action("Index", "BeerGuide", new { prompt = rebelPrompt }))], "rs-ego--small rs-food-pair")' />
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    }
                </div>

                @* He hosts from the side and talks about whatever you point at (the same
                   words are on the prints, so screen readers skip him). *@
                <aside class="rs-studio-host" aria-hidden="true">
                    <div class="rs-studio-host-stand">
                        <span class="rs-ego-bubble rs-studio-host-says">
                            <span class="rs-ego-who">@host.Name</span>
                            <span class="rs-ego-line" data-rs-host-says>@hostOpening</span>
                        </span>
                        <img class="rs-studio-host-look" src="@Url.Content($"~/art/looks/{host.Key}.webp")" asp-append-version="true" width="400" height="520" alt="" loading="lazy" />
                    </div>
                </aside>
            </div>
        </div>
    }
</div>

@section Styles {
    @if (selectedSection == "beer")
    {
        <link rel="stylesheet"
              href="~/css/beer-menu.css"
              asp-append-version="true" />
    }
}

@section Scripts {
    @if (selectedSection == "beer")
    {
        <script src="~/js/beer-menu.js" asp-append-version="true"></script>
    }
    else
    {
        <script>
            (() => {
                const searchInput = document.getElementById("menuSearchInput");
                const summary = document.getElementById("menuFilterSummary");
                const emptyState = document.getElementById("menuFilterEmpty");
                const clearButton = document.getElementById("menuFilterClear");
                const chips = Array.from(document.querySelectorAll(".rs-food-chips [data-filter]"));
                const items = Array.from(document.querySelectorAll("[data-menu-item]"));
                const categories = Array.from(document.querySelectorAll("[data-menu-category]"));

                if (!searchInput || !items.length) {
                    return;
                }

                let activeFilter = "all";

                const setActiveChip = (filter) => {
                    activeFilter = filter;

                    chips.forEach((chip) => {
                        const isActive = chip.dataset.filter === filter;
                        chip.classList.toggle("is-active", isActive);
                        chip.setAttribute("aria-pressed", isActive ? "true" : "false");
                    });
                };

                const applyFilters = () => {
                    const query = searchInput.value.trim().toLowerCase();
                    let visibleCount = 0;

                    items.forEach((item) => {
                        const matchesSearch = !query || item.dataset.search.includes(query);
                        const matchesFilter =
                            activeFilter === "all" ||
                            item.dataset.tags.split(" ").includes(activeFilter);
                        const isVisible = matchesSearch && matchesFilter;

                        item.hidden = !isVisible;

                        if (isVisible) {
                            visibleCount++;
                        }
                    });

                    categories.forEach((category) => {
                        category.hidden = category.querySelector("[data-menu-item]:not([hidden])") === null;
                    });

                    if (summary) {
                        summary.textContent = visibleCount === 1
                            ? "1 item found"
                            : `${visibleCount} items found`;
                    }

                    if (emptyState) {
                        emptyState.hidden = visibleCount > 0;
                    }
                };

                chips.forEach((chip) => {
                    chip.addEventListener("click", () => {
                        setActiveChip(chip.dataset.filter ?? "all");
                        applyFilters();
                    });
                });

                searchInput.addEventListener("input", applyFilters);

                clearButton?.addEventListener("click", () => {
                    searchInput.value = "";
                    setActiveChip("all");
                    applyFilters();
                    searchInput.focus();
                });

                applyFilters();

                // Life on Mars? talks about whatever you point at, and about the set you are in.
                const hostSays = document.querySelector("[data-rs-host-says]");

                if (hostSays) {
                    const bubble = hostSays.parentElement;
                    let standing = hostSays.textContent;

                    const say = (line) => {
                        if (!line || line === hostSays.textContent) {
                            return;
                        }

                        hostSays.textContent = line;
                        bubble.classList.remove("is-new");
                        void bubble.offsetWidth;
                        bubble.classList.add("is-new");
                    };

                    items.forEach((item) => {
                        item.addEventListener("pointerenter", () => say(item.dataset.rsHostLine));
                        item.addEventListener("focusin", () => say(item.dataset.rsHostLine));
                        item.addEventListener("pointerleave", () => say(standing));
                    });

                    if ("IntersectionObserver" in window) {
                        const sets = new IntersectionObserver(
                            (entries) => {
                                entries.forEach((entry) => {
                                    if (entry.isIntersecting) {
                                        standing = entry.target.dataset.rsSetLine;
                                        say(standing);
                                    }
                                });
                            },
                            { rootMargin: "-45% 0px -45% 0px" });

                        categories.forEach((category) => sets.observe(category));
                    }
                }
            })();
        </script>
    }
}
