@{
    var configuration =
        Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions
            .GetRequiredService<Microsoft.Extensions.Configuration.IConfiguration>(Context.RequestServices);
    var hideAiFeatures = bool.TryParse(
        configuration["Presentation:HideAiFeatures"],
        out var hideAi) && hideAi;

    var pageTitle = ViewData["Title"]?.ToString();
    var metaTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Rebel Rebel by Fat Kitchen"
        : $"{pageTitle} - Rebel Rebel by Fat Kitchen";

    var metaDescription =
        ViewData["MetaDescription"]?.ToString()
        ?? "Rebel Rebel by Fat Kitchen in Skopje. Bold pub food, rare beer, events, and table reservations.";

    var ogImage =
        ViewData["OgImage"]?.ToString()
        ?? Url.Content("~/images/email/rebel-logo.png");

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string IsActive(string controller, string? action = null)
    {
        var controllerMatches =
            currentController.Equals(
                controller,
                StringComparison.OrdinalIgnoreCase
            );

        var actionMatches =
            string.IsNullOrWhiteSpace(action) ||
            currentAction.Equals(
                action,
                StringComparison.OrdinalIgnoreCase
            );

        return controllerMatches && actionMatches
            ? "active"
            : "";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@metaTitle</title>

    <script>
        (function (root) {
            root.classList.add("rs-js");

            // The launch countdown plays once per visit.
            try {
                if (sessionStorage.getItem("rs-seen")) {
                    root.classList.add("rs-seen");
                } else {
                    sessionStorage.setItem("rs-seen", "1");
                }
            } catch (e) {
                root.classList.add("rs-seen");
            }
        })(document.documentElement);
    </script>

    <meta name="description"
          content="@metaDescription" />

    <meta name="robots"
          content="index, follow" />

    <meta property="og:type"
          content="website" />

    <meta property="og:title"
          content="@metaTitle" />

    <meta property="og:description"
          content="@metaDescription" />

    <meta property="og:image"
          content="@ogImage" />

    <meta property="og:site_name"
          content="Rebel Rebel by Fat Kitchen" />

    <meta name="twitter:card"
          content="summary_large_image" />

    <link rel="canonical"
          href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/beer-guide.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600..900&family=Big+Shoulders+Stencil+Display:wght@700..900&family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Monoton&family=Playfair+Display:ital,wght@0,700..900;1,700..900&family=Rock+Salt&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
          rel="stylesheet" />
</head>

<body class="rr-public-shell">

    <a class="visually-hidden-focusable rs-skip" href="#main">Skip to content</a>

    <canvas class="rs-sky" data-rs-sky aria-hidden="true"></canvas>
    <div class="rs-sky-warm" aria-hidden="true"></div>

    <svg class="rs-defs" aria-hidden="true" focusable="false">
        <!-- Halftone dots for Bowie's looks (Views/Shared/Looks). -->
        <defs>
            <pattern id="rs-dots" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(28)"><circle cx="2.5" cy="2.5" r="1.3" fill="#1a0f0d" /></pattern>
            <pattern id="rs-dots-red" width="4.4" height="4.4" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)"><circle cx="2.2" cy="2.2" r="1.25" fill="#c3220f" /></pattern>
            <pattern id="rs-dots-light" width="4.4" height="4.4" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)"><circle cx="2.2" cy="2.2" r="1.1" fill="#fff1dc" /></pattern>
        </defs>
        <symbol id="rs-bolt" viewBox="0 0 100 100">
            <path d="M60 0 18 57h27L31 100l53-62H56L72 0Z" />
        </symbol>
        <!-- Aladdin Sane: a red bolt with its light-blue edge printed a little out of register. -->
        <symbol id="rs-bolt-sane" viewBox="-8 -4 112 108">
            <path style="fill: var(--bolt-b, #9ad3f0)" transform="translate(-7 4)" d="M60 0 18 57h27L31 100l53-62H56L72 0Z" />
            <path style="fill: var(--bolt-a, #e2401a)" d="M60 0 18 57h27L31 100l53-62H56L72 0Z" />
        </symbol>
        <symbol id="rs-star" viewBox="0 0 100 100">
            <path d="M50 0C54 34 66 46 100 50C66 54 54 66 50 100C46 66 34 54 0 50C34 46 46 34 50 0Z" />
        </symbol>
        <!-- Space Oddity. -->
        <symbol id="rs-rocket" viewBox="0 0 100 100">
            <path d="M50 2C66 16 72 40 67 66H33C28 40 34 16 50 2Z" />
            <path d="M33 50 18 70l2 12 15-10ZM67 50l15 20-2 12-15-10Z" />
            <circle cx="50" cy="36" r="8" style="fill: var(--rocket-window, #9ad3f0)" />
            <path style="fill: var(--rocket-flame, #ffd86a)" d="M38 70h24l-4 14-8 14-8-14Z" />
        </symbol>
        <symbol id="rs-play" viewBox="0 0 100 100">
            <path d="M18 8 92 50 18 92Z" />
        </symbol>
    </svg>

    <div class="rs-preloader" aria-hidden="true" data-rs-preloader>
        <canvas class="rs-preloader-warp" data-rs-warp></canvas>
        <p class="rs-preloader-label">Ground Control · Rebel Rebel · Skopje</p>
        <p class="rs-preloader-count" data-rs-count>10</p>
        <p class="rs-preloader-status"><i class="rs-led"></i><span data-rs-status>Countdown</span></p>
    </div>

    <header class="rs-header">
        <div class="rs-header-inner">
            <a asp-controller="Home"
               asp-action="Index"
               class="rs-brand">
                <img src="~/images/email/rebel-logo.png"
                     alt=""
                     class="rs-brand-logo" />

                <span class="rs-brand-text">
                    <strong>Rebel Rebel</strong>
                    <small>by Fat Kitchen</small>
                </span>
            </a>

            @* The nav is a ransom note: every link a scrap cut out of a different
               magazine. rebel-cutup.js cuts the letters out one by one. *@
            <nav class="rs-nav" aria-label="Main">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="rs-nav-link @IsActive("Home", "Index")"
                   aria-current="@(IsActive("Home", "Index") == "active" ? "page" : null)"
                   data-rs-ransom>Home</a>

                <a asp-controller="Home"
                   asp-action="Menu"
                   asp-route-section="food"
                   class="rs-nav-link @IsActive("Home", "Menu")"
                   aria-current="@(IsActive("Home", "Menu") == "active" ? "page" : null)"
                   data-rs-ransom>Menu</a>

                @if (!hideAiFeatures)
                {
                    <a asp-controller="BeerGuide"
                       asp-action="Index"
                       class="rs-nav-link @IsActive("BeerGuide")"
                       aria-current="@(IsActive("BeerGuide") == "active" ? "page" : null)"
                       data-rs-ransom>Rebel AI</a>
                }

                <a asp-controller="Events"
                   asp-action="Index"
                   class="rs-nav-link @IsActive("Events")"
                   aria-current="@(IsActive("Events") == "active" ? "page" : null)"
                   data-rs-ransom>Events</a>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="rs-nav-link @IsActive("Home", "Contact")"
                   aria-current="@(IsActive("Home", "Contact") == "active" ? "page" : null)"
                   data-rs-ransom>Contact</a>

                <a asp-controller="Reservations"
                   asp-action="Lookup"
                   class="rs-nav-link @IsActive("Reservations", "Lookup")"
                   aria-current="@(IsActive("Reservations", "Lookup") == "active" ? "page" : null)"
                   data-rs-ransom>My booking</a>
            </nav>

            @* Booking is a ticket: the stub tears off when you go for it. *@
            <a asp-controller="Reservations"
               asp-action="Create"
               class="rs-ticket rs-header-book">
                <span class="rs-ticket-main">Book a table</span>
                <span class="rs-ticket-stub" aria-hidden="true">Admit<b>you</b></span>
            </a>

            @* The menu hides behind the bar's neon sign, with one tube on the blink. *@
            <a href="#open"
               class="rs-open-toggle"
               aria-controls="open"
               aria-expanded="false"
               aria-label="Open menu"
               data-rs-open-toggle>
                <svg viewBox="-8 -4 112 108" aria-hidden="true"><use href="#rs-bolt-sane" /></svg>
                <span class="rs-neon-word">Op<i>e</i>n</span>
            </a>
        </div>
    </header>

    <div class="rs-open"
         id="open"
         role="dialog"
         aria-modal="true"
         aria-label="Site menu"
         data-rs-open>
        <div class="rs-starman rs-open-starman" aria-hidden="true"></div>

        <div class="rs-open-inner">
            <div class="rs-open-top">
                <span class="rs-open-label">Rebel Rebel · Skopje · since May 2025</span>

                <a href="#" class="rs-open-close" data-rs-open-close>
                    Close <span aria-hidden="true">&times;</span>
                </a>
            </div>

            <nav class="rs-open-nav" aria-label="Site menu links">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="rs-open-link"
                   aria-current="@(IsActive("Home", "Index") == "active" ? "page" : null)"
                   data-rs-preview="home">
                    <span class="rs-open-num">01</span>
                    <span class="rs-open-word">Home</span>
                    <small>The bar</small>
                </a>

                <a asp-controller="Home"
                   asp-action="Menu"
                   asp-route-section="food"
                   class="rs-open-link"
                   aria-current="@(IsActive("Home", "Menu") == "active" ? "page" : null)"
                   data-rs-preview="menu">
                    <span class="rs-open-num">02</span>
                    <span class="rs-open-word">Menu</span>
                    <small>Food, beer &amp; drinks</small>
                </a>

                @if (!hideAiFeatures)
                {
                    <a asp-controller="BeerGuide"
                       asp-action="Index"
                       class="rs-open-link"
                       aria-current="@(IsActive("BeerGuide") == "active" ? "page" : null)"
                       data-rs-preview="ai">
                        <span class="rs-open-num">03</span>
                        <span class="rs-open-word">Rebel AI</span>
                        <small>Can't decide?</small>
                    </a>
                }

                <a asp-controller="Events"
                   asp-action="Index"
                   class="rs-open-link"
                   aria-current="@(IsActive("Events") == "active" ? "page" : null)"
                   data-rs-preview="events">
                    <span class="rs-open-num">04</span>
                    <span class="rs-open-word">Events</span>
                    <small>Live nights</small>
                </a>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="rs-open-link"
                   aria-current="@(IsActive("Home", "Contact") == "active" ? "page" : null)"
                   data-rs-preview="contact">
                    <span class="rs-open-num">05</span>
                    <span class="rs-open-word">Contact</span>
                    <small>Hours &amp; directions</small>
                </a>

                <a asp-controller="Reservations"
                   asp-action="Lookup"
                   class="rs-open-link"
                   aria-current="@(IsActive("Reservations", "Lookup") == "active" ? "page" : null)"
                   data-rs-preview="booking">
                    <span class="rs-open-num">06</span>
                    <span class="rs-open-word">My booking</span>
                    <small>Check your table</small>
                </a>
            </nav>

            <div class="rs-open-preview" aria-hidden="true">
                <img src="~/images/rebel-bowie-mural.webp" alt="" loading="lazy" data-rs-preview-img="home" />
                <img src="~/images/rebel-six-beers.webp" alt="" loading="lazy" data-rs-preview-img="menu" />
                <img src="~/images/rebel-beers-bowie-sculpture.webp" alt="" loading="lazy" data-rs-preview-img="ai" />
                <img src="~/images/rebel-liquid-cocaine-mural-room.webp" alt="" loading="lazy" data-rs-preview-img="events" />
                <img src="~/images/rebel-exterior-yugo-night.webp" alt="" loading="lazy" data-rs-preview-img="contact" />
                <img src="~/images/rebel-bowie-logo-room.webp" alt="" loading="lazy" data-rs-preview-img="booking" />
            </div>

            <div class="rs-open-foot">
                <p><strong>Visit</strong><br />Naum Naumovski Borce 62, Skopje</p>
                <p><strong>Open every day</strong><br />12:00 – 01:00</p>

                <a asp-controller="Reservations"
                   asp-action="Create"
                   class="rs-btn rs-btn--primary">
                    Book a table <i aria-hidden="true">&rarr;</i>
                </a>
            </div>
        </div>
    </div>

    <main role="main" id="main">
        @RenderBody()
    </main>

    <footer class="rs-footer" data-rs-stardust>
        <span class="rs-stars"></span>

        <partial name="_Rail" model='new RailModel(null, "Last call · 01:00", "rs-rail--footer")' />

        @* The Blind Prophet, the face of Rebel AI, sees you out. *@
        <partial name="_Look" model='new LookModel("prophet", "footer", "rs-footer-look")' />

        @if (!hideAiFeatures)
        {
            <a class="rs-look-tag rs-look-tag--footer" asp-controller="BeerGuide" asp-action="Index">
                <b>Can't decide?</b> Ask Rebel AI <i aria-hidden="true">&rarr;</i>
            </a>
        }

        <div class="rs-container rs-footer-main">
            <div class="rs-footer-brand">
                <p class="rs-footer-word" aria-label="Rebel Rebel">
                    Rebel
                    <span>Rebel</span>
                </p>
                <p class="rs-footer-note">Heroes, just for one night.</p>
            </div>

            <nav class="rs-footer-col" aria-label="Footer">
                <h2>Explore</h2>
                <ul>
                    <li><a asp-controller="Home" asp-action="Menu" asp-route-section="food">Food menu</a></li>
                    <li><a asp-controller="Home" asp-action="Menu" asp-route-section="beer">Beer menu</a></li>
                    <li><a asp-controller="Events" asp-action="Index">Events</a></li>
                    @if (!hideAiFeatures)
                    {
                        <li><a asp-controller="BeerGuide" asp-action="Index">Rebel AI</a></li>
                    }
                    <li><a asp-controller="Reservations" asp-action="Lookup">My booking</a></li>
                </ul>
            </nav>

            <div class="rs-footer-col">
                <h2>Visit</h2>
                <p>
                    Naum Naumovski Borce 62<br />
                    Skopje
                </p>
                <p>Open every day<br />12:00 – 01:00</p>
                <p><a asp-controller="Home" asp-action="Contact">Contact &amp; directions</a></p>
            </div>

            <div class="rs-footer-cta">
                <p>Walk in or play it smart.</p>
                <a asp-controller="Reservations"
                   asp-action="Create"
                   class="rs-btn rs-btn--primary">
                    Book a table <i aria-hidden="true">&rarr;</i>
                </a>
            </div>
        </div>

        <div class="rs-footer-bottom">
            <div class="rs-container">
                <span>© 2026 Rebel Rebel by Fat Kitchen · Skopje</span>
                <span>Cold beer // Loud records // Fat Kitchen food</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/rebel-sky.js" asp-append-version="true"></script>

    <script src="~/js/rebel-site.js" asp-append-version="true"></script>

    <script src="~/js/rebel-cutup.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
