@* The hairline Ground Control frame laid over a chapter: corner ticks, the mission
   clock, an altitude tape that follows the scroll and a reticle. *@
<div class="rs-hud" aria-hidden="true">
    <span class="rs-hud-read">T+ <b data-rs-clock>00:00:00</b></span>
    <span class="rs-hud-tape"></span>
    <span class="rs-hud-cross"></span>
</div>
