@model Rebel.Web.Models.EraModel

<div class="rs-era @Model.CssClass" aria-hidden="true">
    <b class="rs-era-year">@Model.Year</b>
    <svg class="rs-era-icon rs-era-icon--@Model.Icon" viewBox="0 0 100 100"><use href="#rs-@Model.Icon" /></svg>
    <span class="rs-era-title">@Model.Title</span>
</div>
