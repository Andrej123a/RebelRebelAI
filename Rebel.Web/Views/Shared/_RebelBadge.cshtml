@model Rebel.Web.Models.RebelBadgeModel

<div class="rs-badge @Model.CssClass" aria-hidden="true">
    <svg class="rs-badge-ring" viewBox="0 0 200 200">
        <defs>
            <path id="@Model.Id"
                  d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0" />
        </defs>
        <text style="font-size: @(Model.FontSize)px">
            <textPath href="#@Model.Id">@Model.RingText</textPath>
        </text>
    </svg>
    <svg class="rs-badge-bolt" viewBox="0 0 100 100">
        <use href="#rs-bolt" />
    </svg>
</div>
