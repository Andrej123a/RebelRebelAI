@model Rebel.Web.Models.LookModel

@* One of Bowie's characters, painted (Art/Looks, rendered to wwwroot/art/looks). *@
<img class="rs-look rs-look--@Model.Key @Model.CssClass"
     src="@Url.Content($"~/art/looks/{Model.Key}.webp")"
     asp-append-version="true"
     width="400"
     height="520"
     alt=""
     aria-hidden="true"
     decoding="async" />
