@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
    ViewData["MetaDescription"] = "Rebel Rebel by Fat Kitchen could not load this page. Return home, view the menu, or book a table.";
}

<section class="rs-chapter rs-chapter--space rs-error" data-rs-stardust>
    <span class="rs-stars"></span>

    <div class="rs-earth rs-earth--dawn rs-error-earth" aria-hidden="true"><i></i></div>

    <div class="rs-container rs-error-inner">
        <div class="rs-error-tom" aria-hidden="true">
            <partial name="_Look" model='new LookModel("tom")' />
            <span class="rs-error-tether"></span>
        </div>

        <div>
            <h1 class="rs-display rs-display--lg">Something went sideways.</h1>

            <p class="rs-lead">
                The page could not be loaded right now. Try again, or head back to the main Rebel Rebel by Fat Kitchen pages.
            </p>

            @* Rebel Rebel takes you back; the others are a call away. *@
            <div class="rs-egos rs-error-actions">
                <partial name="_Ego" model="BowieCalls.Home(Url)" />
                <partial name="_Ego" model='BowieCalls.Food(Url, "rs-ego--small")' />
                <partial name="_Ego" model='BowieCalls.Book(Url, "rs-ego--small")' />
            </div>

            @if (Model.ShowRequestId)
            {
                <small class="rs-error-ref">
                    Reference: @Model.RequestId
                </small>
            }
        </div>
    </div>
</section>
