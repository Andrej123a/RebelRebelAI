@model List<Rebel.Domain.Entities.Reservation>
@using Rebel.Domain.Enums
@using Rebel.Domain.Entities
@using Rebel.Web.Services

@{
    ViewData["Title"] = "Planner";

    var today = (DateTime)(ViewBag.Today ?? DateTime.Today);
    var startDate = (DateTime)(ViewBag.StartDate ?? today);
    var endDate = (DateTime)(ViewBag.EndDate ?? startDate.AddDays(6));
    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? today);
    var previousWeek = (DateTime)(ViewBag.PreviousWeek ?? startDate.AddDays(-7));
    var nextWeek = (DateTime)(ViewBag.NextWeek ?? startDate.AddDays(7));
    var slotCapacity = (int)(ViewBag.SlotCapacity ?? 40);
    var reservationSlots =
        ViewBag.ReservationSlots as IReadOnlyList<TimeSpan>
        ?? Array.Empty<TimeSpan>();
    var plannerEvents =
        ViewBag.Events as List<Event>
        ?? new List<Event>();

    var dates = Enumerable.Range(0, 7)
        .Select(offset => startDate.Date.AddDays(offset))
        .ToList();

    var activeReservations = Model
        .Where(reservation =>
            reservation.Status != ReservationStatus.NoShow &&
            reservation.Status != ReservationStatus.Cancelled &&
            reservation.Status != ReservationStatus.Rejected)
        .ToList();

    var selectedReservations = activeReservations
        .Where(reservation => reservation.ReservationDate.Date == selectedDate.Date)
        .OrderBy(reservation => reservation.ReservationTime)
        .ThenBy(reservation => reservation.FullName)
        .ToList();

    var selectedEvents = plannerEvents
        .Where(eventItem => eventItem.Date.Date == selectedDate.Date)
        .OrderBy(eventItem => eventItem.StartTime)
        .ThenBy(eventItem => eventItem.Title)
        .ToList();
    var scheduledEvents = selectedEvents
        .Where(eventItem => eventItem.StartTime.HasValue)
        .ToList();
    var plannerClosingBoundary =
        PlannerSchedulePolicy.GetClosingBoundary(selectedDate);
    var extendedPlannerSlots = reservationSlots.ToList();
    var firstExtendedSlot = extendedPlannerSlots.Count > 0
        ? extendedPlannerSlots.Max().Add(ReservationPolicy.SlotInterval)
        : ReservationPolicy.FirstOnlineSlot;

    for (var slot = firstExtendedSlot;
         slot < plannerClosingBoundary;
         slot = slot.Add(ReservationPolicy.SlotInterval))
    {
        extendedPlannerSlots.Add(slot);
    }

    Func<TimeSpan, string> formatPlannerTime = time =>
        TimeSpan.FromHours(time.TotalHours % 24).ToString(@"hh\:mm");
    Func<Event, TimeSpan> getPlannerEventEnd = eventItem =>
        PlannerSchedulePolicy.ResolveEventEnd(
            selectedDate,
            eventItem.StartTime!.Value,
            eventItem.EndTime);

    var selectedGuests = selectedReservations.Sum(reservation => reservation.NumberOfGuests);
    var selectedPending = selectedReservations.Count(reservation => reservation.Status == ReservationStatus.Pending);
    var selectedWithoutTable = selectedReservations.Count(reservation =>
        reservation.Status == ReservationStatus.Approved &&
        string.IsNullOrWhiteSpace(reservation.TableLabel));
    var selectedIssues = selectedPending + selectedWithoutTable;

    var timelineSlots = extendedPlannerSlots
        .Concat(selectedReservations.Select(reservation => reservation.ReservationTime))
        .Concat(scheduledEvents.Select(eventItem => eventItem.StartTime!.Value))
        .Distinct()
        .Where(slot => slot < plannerClosingBoundary)
        .OrderBy(slot => slot)
        .ToList();

    var isCurrentWeek = today >= startDate && today <= endDate;
}

<link rel="stylesheet" href="~/css/admin-planner.css" asp-append-version="true" />

<div class="booking-planner">
    <header class="booking-planner-header">
        <div>
            <span class="admin-workspace-eyebrow">@startDate.ToString("dd MMM") — @endDate.ToString("dd MMM yyyy")</span>
            <h1>Planner</h1>
        </div>

        <nav class="booking-week-nav" aria-label="Choose week">
            <a asp-action="Planner"
               asp-route-startDate="@previousWeek.ToString("yyyy-MM-dd")"
               asp-route-date="@previousWeek.ToString("yyyy-MM-dd")"
               aria-label="Previous week">←</a>
            <a asp-action="Planner"
               asp-route-startDate="@today.ToString("yyyy-MM-dd")"
               asp-route-date="@today.ToString("yyyy-MM-dd")"
               class="@(isCurrentWeek ? "is-current" : "")">Today</a>
            <a asp-action="Planner"
               asp-route-startDate="@nextWeek.ToString("yyyy-MM-dd")"
               asp-route-date="@nextWeek.ToString("yyyy-MM-dd")"
               aria-label="Next week">→</a>
        </nav>
    </header>

    <section class="booking-day-strip" aria-label="Choose a day">
        @foreach (var date in dates)
        {
            var dayReservations = activeReservations
                .Where(reservation => reservation.ReservationDate.Date == date)
                .ToList();
            var dayGuests = dayReservations.Sum(reservation => reservation.NumberOfGuests);
            var dayEventCount = plannerEvents.Count(eventItem => eventItem.Date.Date == date);
            var dayIssues = dayReservations.Count(reservation =>
                reservation.Status == ReservationStatus.Pending ||
                (reservation.Status == ReservationStatus.Approved && string.IsNullOrWhiteSpace(reservation.TableLabel)));
            var peakGuests = dayReservations
                .GroupBy(reservation => reservation.ReservationTime)
                .Select(group => group.Sum(reservation => reservation.NumberOfGuests))
                .DefaultIfEmpty(0)
                .Max();
            var load = slotCapacity <= 0 ? 0 : Math.Min(100, (int)Math.Round(peakGuests * 100m / slotCapacity));

            <a asp-action="Planner"
               asp-route-startDate="@startDate.ToString("yyyy-MM-dd")"
               asp-route-date="@date.ToString("yyyy-MM-dd")"
               class="booking-day @(date == selectedDate ? "is-selected" : "") @(date == today ? "is-today" : "")">
                <span>@date.ToString("ddd")</span>
                <strong>@date.ToString("dd")</strong>
                <small>
                    @dayGuests guests
                    @if (dayEventCount > 0)
                    {
                        <b class="booking-day-event-count">@dayEventCount event@(dayEventCount == 1 ? string.Empty : "s")</b>
                    }
                </small>
                @if (dayIssues > 0)
                {
                    <em>@dayIssues</em>
                }
                <i style="--day-load: @load%" aria-hidden="true"></i>
            </a>
        }
    </section>

    <section class="booking-day-head">
        <div>
            <span>@(selectedDate == today ? "Today" : selectedDate.ToString("dddd"))</span>
            <h2>@selectedDate.ToString("dd MMMM")</h2>
        </div>

        <div class="booking-day-totals">
            <span><strong>@selectedReservations.Count</strong> bookings</span>
            <span><strong>@selectedGuests</strong> guests</span>
            @if (selectedEvents.Count > 0)
            {
                <span class="has-event"><strong>@selectedEvents.Count</strong> event@(selectedEvents.Count == 1 ? string.Empty : "s")</span>
            }
            @if (selectedIssues > 0)
            {
                <span class="has-issues"><strong>@selectedIssues</strong> need action</span>
            }
        </div>
    </section>

    @if (selectedIssues > 0)
    {
        <section class="booking-action-strip" aria-label="Reservations needing action">
            <strong>Needs action</strong>
            @if (selectedPending > 0)
            {
                <a asp-action="Index"
                   asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                   asp-route-status="Pending">@selectedPending pending</a>
            }
            @if (selectedWithoutTable > 0)
            {
                <a asp-action="Index"
                   asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                   asp-route-needsTable="true">@selectedWithoutTable without table</a>
            }
        </section>
    }

    @if (selectedEvents.Any(eventItem => !eventItem.StartTime.HasValue))
    {
        <section class="booking-unscheduled-events" aria-label="Events without a confirmed start time">
            @foreach (var eventItem in selectedEvents.Where(eventItem => !eventItem.StartTime.HasValue))
            {
                <a asp-controller="AdminEvents"
                   asp-action="Bookings"
                   asp-route-id="@eventItem.Id">
                    <span>Time TBC</span>
                    <strong>@eventItem.Title</strong>
                </a>
            }
        </section>
    }

    @if (scheduledEvents.Count > 0)
    {
        <section class="booking-mobile-events" aria-label="Events for the selected day">
            @foreach (var eventItem in scheduledEvents)
            {
                var mobileEventEnd = getPlannerEventEnd(eventItem);

                <a asp-controller="AdminEvents"
                   asp-action="Bookings"
                   asp-route-id="@eventItem.Id">
                    @if (!string.IsNullOrWhiteSpace(eventItem.ImageUrl))
                    {
                        <img src="@Url.Content(eventItem.ImageUrl)"
                             class="booking-event-backdrop"
                             alt=""
                             aria-hidden="true"
                             loading="lazy" />
                        <img src="@Url.Content(eventItem.ImageUrl)"
                             class="booking-event-poster"
                             alt=""
                             loading="lazy" />
                    }
                    <span>
                        <small>@formatPlannerTime(eventItem.StartTime!.Value)–@formatPlannerTime(mobileEventEnd)</small>
                        <strong>@eventItem.Title</strong>
                    </span>
                </a>
            }
        </section>
    }

    <section class="booking-timeline @(scheduledEvents.Count > 0 ? "has-events" : string.Empty)"
             aria-label="Reservations for @selectedDate.ToString("dddd dd MMMM")">
        @for (var slotIndex = 0; slotIndex < timelineSlots.Count; slotIndex++)
        {
            var slot = timelineSlots[slotIndex];
            var nextSlot = slotIndex + 1 < timelineSlots.Count
                ? timelineSlots[slotIndex + 1]
                : slot.Add(ReservationPolicy.SlotInterval);
            var slotReservations = selectedReservations
                .Where(reservation => reservation.ReservationTime == slot)
                .ToList();
            var slotGuests = slotReservations.Sum(reservation => reservation.NumberOfGuests);
            var slotLoad = slotCapacity <= 0 ? 0 : Math.Min(100, (int)Math.Round(slotGuests * 100m / slotCapacity));
            var slotHasEvent = scheduledEvents.Any(eventItem =>
                eventItem.StartTime!.Value < nextSlot &&
                getPlannerEventEnd(eventItem) > slot);

            <article class="booking-time-row @(slotReservations.Count == 0 ? "is-empty" : "") @(slotGuests >= slotCapacity ? "is-full" : "") @(slotHasEvent ? "has-event" : "")">
                <header class="booking-time" style="--planner-row: @(slotIndex + 1);">
                    <strong>@formatPlannerTime(slot)</strong>
                    <span>@slotGuests / @slotCapacity</span>
                    <i><b style="--slot-load: @slotLoad%"></b></i>
                </header>

                <div class="booking-time-reservations" style="--planner-row: @(slotIndex + 1);">
                    @if (slotReservations.Count == 0)
                    {
                        <span class="booking-open-slot">Open</span>
                    }
                    else
                    {
                        @foreach (var reservation in slotReservations)
                        {
                            var needsTable =
                                reservation.Status == ReservationStatus.Approved &&
                                string.IsNullOrWhiteSpace(reservation.TableLabel);
                            var statusClass = reservation.Status switch
                            {
                                ReservationStatus.Pending => "is-pending",
                                ReservationStatus.Arrived => "is-arrived",
                                _ when needsTable => "is-unassigned",
                                _ => "is-ready"
                            };
                            var statusLabel = reservation.Status switch
                            {
                                ReservationStatus.Pending => "Review",
                                ReservationStatus.Arrived => "Seated",
                                _ when needsTable => "No table",
                                _ => "Ready"
                            };

                            <a asp-action="Details"
                               asp-route-id="@reservation.Id"
                               class="booking-card @statusClass">
                                <span class="booking-card-status">@statusLabel</span>
                                <strong>@reservation.FullName</strong>
                                <span class="booking-card-guests">@reservation.NumberOfGuests @(reservation.NumberOfGuests == 1 ? "guest" : "guests")</span>
                                <span class="booking-card-table">
                                    @(string.IsNullOrWhiteSpace(reservation.TableLabel) ? "—" : reservation.TableLabel)
                                </span>
                                @if (reservation.EventId.HasValue)
                                {
                                    <span class="booking-card-event">Event</span>
                                }
                                <span class="booking-card-arrow" aria-hidden="true">→</span>
                            </a>
                        }
                    }
                </div>

                @if (scheduledEvents.Count > 0)
                {
                    <div class="booking-event-track-cell"
                         style="--planner-row: @(slotIndex + 1);"
                         aria-hidden="true"></div>
                }
            </article>
        }

        @foreach (var eventItem in scheduledEvents)
        {
            var eventStart = eventItem.StartTime!.Value;
            var eventEnd = getPlannerEventEnd(eventItem);
            var eventStartIndex = timelineSlots.FindIndex(slot => slot >= eventStart);
            var eventEndIndex = timelineSlots.FindIndex(slot => slot >= eventEnd);

            if (eventStartIndex >= 0)
            {
                if (eventEndIndex < 0)
                {
                    eventEndIndex = timelineSlots.Count;
                }

                var gridRowStart = eventStartIndex + 1;
                var gridRowEnd = Math.Max(gridRowStart + 1, eventEndIndex + 1);

                <a asp-controller="AdminEvents"
                   asp-action="Bookings"
                   asp-route-id="@eventItem.Id"
                   class="booking-event-block"
                   style="grid-row: @gridRowStart / @gridRowEnd;">
                    @if (!string.IsNullOrWhiteSpace(eventItem.ImageUrl))
                    {
                        <img src="@Url.Content(eventItem.ImageUrl)"
                             class="booking-event-backdrop"
                             alt=""
                             aria-hidden="true"
                             loading="lazy" />
                        <img src="@Url.Content(eventItem.ImageUrl)"
                             class="booking-event-poster"
                             alt="@eventItem.Title event poster"
                             loading="lazy" />
                    }
                    else
                    {
                        <span class="booking-event-block-placeholder" aria-hidden="true"></span>
                    }

                    <span class="booking-event-block-shade" aria-hidden="true"></span>
                    <span class="booking-event-block-copy">
                        <small>Event · @formatPlannerTime(eventStart)–@formatPlannerTime(eventEnd)</small>
                        <strong>@eventItem.Title</strong>
                        <em>Open event bookings &rarr;</em>
                    </span>
                </a>
            }
        }

        @if (timelineSlots.Count == 0)
        {
            <div class="booking-planner-empty">
                <strong>No reservation slots</strong>
                <span>There is nothing scheduled for this day.</span>
            </div>
        }
    </section>
</div>
