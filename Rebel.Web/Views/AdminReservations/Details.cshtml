@model Rebel.Domain.Entities.Reservation
@using Rebel.Domain.Enums
@using Rebel.Web.Models

@{
    ViewData["Title"] = "Reservation";

    var skopjeTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Skopje");

    var createdAtUtc = DateTime.SpecifyKind(
        Model.CreatedAtUtc,
        DateTimeKind.Utc);

    var createdInSkopje = TimeZoneInfo.ConvertTimeFromUtc(
        createdAtUtc,
        skopjeTimeZone);

    var activeTables =
        ViewBag.ActiveTables as List<Rebel.Domain.Entities.PubTable>
        ?? new List<Rebel.Domain.Entities.PubTable>();

    var busyTables =
        ViewBag.BusyTables as List<string>
        ?? new List<string>();

    var floorRooms =
        ViewBag.FloorRooms as List<Rebel.Domain.Entities.FloorRoom>
        ?? new List<Rebel.Domain.Entities.FloorRoom>();

    var floorFixtures =
        ViewBag.FloorFixtures as List<Rebel.Domain.Entities.FloorFixture>
        ?? new List<Rebel.Domain.Entities.FloorFixture>();

    var activities =
        ViewBag.ReservationActivities as List<Rebel.Domain.Entities.ReservationActivity>
        ?? new List<Rebel.Domain.Entities.ReservationActivity>();

    var tableWasReleased =
        Model.Status == ReservationStatus.Arrived &&
        string.IsNullOrWhiteSpace(Model.TableLabel) &&
        activities.Any(activity => activity.Title == "Table released");

    var recommendedTable = activeTables
        .Where(table =>
            !busyTables.Contains(table.Label) &&
            table.Capacity >= Model.NumberOfGuests)
        .OrderBy(table => table.Capacity)
        .ThenBy(table => table.Area)
        .ThenBy(table => table.Label)
        .FirstOrDefault();

    var canEditFloor =
        Model.Status != ReservationStatus.Rejected &&
        Model.Status != ReservationStatus.NoShow &&
        Model.Status != ReservationStatus.Cancelled &&
        !tableWasReleased;

    var canCancel =
        Model.Status == ReservationStatus.Pending ||
        Model.Status == ReservationStatus.Approved;

    var hasGuestEmail =
        !string.IsNullOrWhiteSpace(Model.Email);

    var emailFailed =
        hasGuestEmail &&
        Model.EmailStatus?.Contains(
            "Failed",
            StringComparison.OrdinalIgnoreCase) == true;

    var statusLabel = Model.Status switch
    {
        ReservationStatus.Pending => "Needs review",
        ReservationStatus.Approved => "Approved",
        ReservationStatus.Arrived => "Arrived",
        ReservationStatus.NoShow => "No-show",
        ReservationStatus.Cancelled => "Cancelled",
        ReservationStatus.Rejected => "Rejected",
        _ => Model.Status.ToString()
    };

    var statusClass = Model.Status switch
    {
        ReservationStatus.Pending => "is-attention",
        ReservationStatus.Arrived => "is-success",
        ReservationStatus.NoShow => "is-danger",
        ReservationStatus.Cancelled => "is-danger",
        ReservationStatus.Rejected => "is-danger",
        _ => string.Empty
    };

    var emailStatusLabel = Model.EmailStatus switch
    {
        "RequestSent" => "Request email sent",
        "ApprovedSent" => "Approval email sent",
        "RejectedSent" => "Rejection email sent",
        "CancelledSent" => "Cancellation email sent",
        "RequestEmailFailed" => "Request email failed",
        "ApprovedEmailFailed" => "Approval email failed",
        "RejectedEmailFailed" => "Rejection email failed",
        "CancelledEmailFailed" => "Cancellation email failed",
        "CodeOnly" => "Code-based booking",
        _ => "Email pending"
    };
}

<div class="admin-workspace reservation-focus-page">

    <header class="admin-workspace-header">
        <div class="admin-workspace-heading">
            <a asp-controller="AdminReservations"
               asp-action="Index"
               class="admin-workspace-eyebrow">
                Back to all bookings
            </a>

            <h1 class="admin-workspace-title">
                @Model.FullName
            </h1>

            <p class="admin-workspace-copy">
                @Model.ReservationDate.ToString("dd MMM yyyy") at @Model.ReservationTime.ToString(@"hh\:mm")
            </p>
        </div>

        <div class="reservation-header-actions">
            <span class="reservation-focus-status @statusClass">
                @statusLabel
            </span>

            <div class="reservation-phone-action">
                <span>Guest phone</span>
                <strong>@Model.PhoneNumber</strong>
                <button type="button"
                        class="admin-secondary-button"
                        data-copy-phone="@Model.PhoneNumber">
                    Copy phone
                </button>
                <small data-copy-phone-status aria-live="polite"></small>
            </div>

            @if (hasGuestEmail)
            {
                <a href="mailto:@Model.Email"
                   class="admin-secondary-button">
                    Email guest
                </a>
            }
        </div>
    </header>

    <section class="admin-metric-bar reservation-summary-bar"
             style="--metric-columns: 5;"
             aria-label="Reservation summary">
        <div class="admin-metric reservation-code-metric">
            <span>Check-in code</span>
            <strong>@Model.ReservationCode</strong>
        </div>

        <div class="admin-metric">
            <span>Party</span>
            <strong>@Model.NumberOfGuests guests</strong>
        </div>

        <div class="admin-metric">
            <span>Date</span>
            <strong>@Model.ReservationDate.ToString("dd MMM")</strong>
        </div>

        <div class="admin-metric">
            <span>Arrival</span>
            <strong>@Model.ReservationTime.ToString(@"hh\:mm")</strong>
        </div>

        <div class="admin-metric @(string.IsNullOrWhiteSpace(Model.TableLabel) ? "is-attention" : "")">
            <span>Table</span>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.TableLabel)
                    ? "Not assigned"
                    : Model.TableLabel)
            </strong>
        </div>
    </section>

    @if (Model.Event != null)
    {
        <section class="reservation-event-card" aria-labelledby="reservationEventTitle">
            <div class="reservation-event-visual">
                @if (!string.IsNullOrWhiteSpace(Model.Event.ImageUrl))
                {
                    <img src="@Url.Content(Model.Event.ImageUrl)"
                         alt="@Model.Event.Title event poster"
                         loading="lazy" />
                }
                else
                {
                    <div class="reservation-event-placeholder" aria-hidden="true">
                        <span>REBEL</span>
                        <strong>EVENT</strong>
                    </div>
                }

                <span class="reservation-event-badge">Event booking</span>
            </div>

            <div class="reservation-event-content">
                <span class="admin-workspace-eyebrow">Reserved for</span>
                <h2 id="reservationEventTitle">@Model.Event.Title</h2>

                <div class="reservation-event-meta">
                    <span>
                        <small>Date</small>
                        <strong>@Model.ReservationDate.ToString("dd MMM yyyy")</strong>
                    </span>
                    <span>
                        <small>Guest arrival</small>
                        <strong>@Model.ReservationTime.ToString(@"hh\:mm")</strong>
                    </span>
                    <span>
                        <small>Event starts</small>
                        <strong>@(Model.Event.StartTime?.ToString(@"hh\:mm") ?? "TBC")</strong>
                    </span>
                </div>

                <a asp-controller="AdminEvents"
                   asp-action="Bookings"
                   asp-route-id="@Model.Event.Id"
                   class="admin-secondary-button">
                    View event bookings
                </a>
            </div>
        </section>
    }

    @if (Model.NumberOfGuests >= 9)
    {
        <div class="reservation-focus-alert reservation-context-alert">
            <span>
                Large party: confirm the seating plan before approval.
            </span>
        </div>
    }

    @if (emailFailed)
    {
        <div class="reservation-focus-alert is-danger">
            <div>
                <strong>@emailStatusLabel</strong>
                <span>@Model.LastEmailError</span>
            </div>

            <form asp-controller="AdminReservations"
                  asp-action="ResendGuestEmail"
                  asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="admin-secondary-button">
                    Resend email
                </button>
            </form>
        </div>
    }

    @if (Model.Status == ReservationStatus.Pending)
    {
        <section class="admin-section">
            <header class="admin-section-heading">
                <div>
                    <span class="admin-workspace-eyebrow">Decision</span>
                    <h2>Review and approve</h2>
                    <p>Assign a table if possible. If the floor is not final, approve without a table and assign it later.</p>
                </div>
            </header>

            <form asp-controller="AdminReservations"
                  asp-action="Approve"
                  method="post"
                  class="admin-form-surface reservation-decision-form">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                @await Html.PartialAsync(
                    "_ReservationFloorPicker",
                    new ReservationFloorPickerViewModel
                    {
                        InputId = "approve-table-label",
                        PartySize = Model.NumberOfGuests,
                        ReservationDate = Model.ReservationDate,
                        ReservationTime = Model.ReservationTime,
                        SelectedTableLabel = recommendedTable?.Label,
                        RecommendedTableLabel = recommendedTable?.Label,
                        Rooms = floorRooms,
                        Tables = activeTables,
                        Fixtures = floorFixtures,
                        BusyTableLabels = busyTables
                    })

                <div class="admin-form-grid">
                    <label>
                        Message to guest
                        <textarea name="adminNote"
                                  rows="2"
                                  maxlength="500"
                                  placeholder="Optional confirmation note"></textarea>
                    </label>

                    <label>
                        Staff-only note
                        <textarea name="internalNote"
                                  rows="2"
                                  maxlength="500"
                                  placeholder="Visible only in admin"></textarea>
                    </label>
                </div>

                <button type="submit"
                        class="admin-primary-button is-success">
                    Approve
                </button>
            </form>
        </section>

        <details class="admin-content-disclosure reservation-reject-disclosure reservation-reject-zone">
            <summary>
                <span class="reservation-disclosure-title">
                    <small>Alternative decision</small>
                    <strong>Decline this request</strong>
                </span>
                <span class="reservation-disclosure-value">Reject</span>
            </summary>

            <form asp-controller="AdminReservations"
                  asp-action="Reject"
                  method="post"
                  class="admin-form-surface">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="admin-form-grid">
                    <label class="wide">
                        Message to guest
                        <textarea name="adminNote"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Short reason or alternative time"></textarea>
                    </label>
                </div>

                <button type="submit"
                        class="admin-primary-button is-danger">
                    Reject
                </button>
            </form>
        </details>
    }
    else if (canEditFloor)
    {
        <details class="admin-content-disclosure reservation-workflow-disclosure"
                 open="@(string.IsNullOrWhiteSpace(Model.TableLabel) ? "open" : null)">
            <summary>
                <span class="reservation-disclosure-title">
                    <small>Floor</small>
                    <strong>Table assignment</strong>
                </span>
                <span class="reservation-disclosure-value">
                    @(string.IsNullOrWhiteSpace(Model.TableLabel)
                        ? "Needs table"
                        : Model.TableLabel)
                </span>
            </summary>

            <form asp-controller="AdminReservations"
                  asp-action="UpdateFloorDetails"
                  method="post"
                  class="admin-form-surface">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                @await Html.PartialAsync(
                    "_ReservationFloorPicker",
                    new ReservationFloorPickerViewModel
                    {
                        InputId = "update-table-label",
                        PartySize = Model.NumberOfGuests,
                        ReservationDate = Model.ReservationDate,
                        ReservationTime = Model.ReservationTime,
                        SelectedTableLabel = Model.TableLabel,
                        RecommendedTableLabel = recommendedTable?.Label,
                        Rooms = floorRooms,
                        Tables = activeTables,
                        Fixtures = floorFixtures,
                        BusyTableLabels = busyTables
                    })

                <div class="admin-form-grid">
                    <label>
                        Staff-only note
                        <input name="internalNote"
                               value="@Model.InternalNote"
                               maxlength="500"
                               placeholder="Optional floor note" />
                    </label>
                </div>

                <button type="submit"
                        class="admin-primary-button">
                    Save table
                </button>
            </form>
        </details>
    }

    @if (Model.Status == ReservationStatus.Approved)
    {
        <section class="admin-section reservation-service-actions">
            <header class="admin-section-heading">
                <div>
                    <span class="admin-workspace-eyebrow">Service</span>
                    <h2>Guest arrival</h2>
                    <p>Check the guest in here. This is the only attendance control for the booking.</p>
                </div>
            </header>

            <form asp-controller="AdminReservations"
                  asp-action="MarkArrived"
                  asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()
                <div class="reservation-code-check">
                    <span>Match with guest</span>
                    <strong>@Model.ReservationCode</strong>
                    <small>Ask the guest to show this code before check-in.</small>
                </div>
                <button type="submit"
                        class="admin-primary-button is-success">
                    Guest arrived
                </button>
            </form>

            <details class="admin-content-disclosure reservation-reject-zone">
                <summary>
                    <span class="reservation-disclosure-title">
                        <small>Alternative</small>
                        <strong>Guest did not arrive</strong>
                    </span>
                    <span class="reservation-disclosure-value">No-show</span>
                </summary>

                <form asp-controller="AdminReservations"
                      asp-action="MarkNoShow"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="admin-form-surface"
                      onsubmit="return confirm('Mark this reservation as a no-show and release its table?');">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="admin-primary-button is-danger">
                        Mark no-show
                    </button>
                </form>
            </details>
        </section>
    }

    @if (Model.Status == ReservationStatus.Arrived &&
         !string.IsNullOrWhiteSpace(Model.TableLabel))
    {
        <section class="admin-section reservation-service-actions reservation-release-table">
            <header class="admin-section-heading">
                <div>
                    <span class="admin-workspace-eyebrow">End service</span>
                    <h2>Release @Model.TableLabel</h2>
                    <p>Use this when the guests leave. The table becomes available immediately.</p>
                </div>
            </header>

            <form asp-controller="AdminReservations"
                  asp-action="ReleaseTable"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Release table @Model.TableLabel and make it available again?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-primary-button is-success">
                    Release table
                </button>
            </form>
        </section>
    }

    @if (tableWasReleased)
    {
        <section class="admin-section reservation-table-released-state">
            <span class="admin-workspace-eyebrow">Service complete</span>
            <h2>Table released</h2>
            <p>The guest visit remains in history, and the table is available for another reservation.</p>
        </section>
    }

    <div class="reservation-reference-grid">
        <details class="admin-content-disclosure reservation-reference-disclosure">
            <summary>
                <span class="reservation-disclosure-title">
                    <small>Guest</small>
                    <strong>Contact &amp; notes</strong>
                </span>
                <span class="reservation-disclosure-value">Open</span>
            </summary>

            <div class="reservation-detail-list">
                <div>
                    <span>Phone</span>
                    <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                </div>

                @if (hasGuestEmail)
                {
                    <div>
                        <span>Email</span>
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </div>
                }

                <div>
                    <span>Submitted</span>
                    <strong>@createdInSkopje.ToString("dd MMM yyyy, HH:mm")</strong>
                </div>

                <div>
                    <span>Guest updates</span>
                    <strong>@emailStatusLabel</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="wide">
                        <span>Guest note</span>
                        <strong>@Model.Note</strong>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                {
                    <div class="wide">
                        <span>Message sent to guest</span>
                        <strong>@Model.AdminNote</strong>
                    </div>
                }
            </div>
        </details>

        <details class="admin-content-disclosure reservation-reference-disclosure">
            <summary>
                <span class="reservation-disclosure-title">
                    <small>Audit trail</small>
                    <strong>Booking history</strong>
                </span>
                <span class="reservation-disclosure-value">
                    @activities.Count update@(activities.Count == 1 ? "" : "s")
                </span>
            </summary>

            <ol class="reservation-focus-log">
                @if (activities.Count == 0)
                {
                    <li>
                        <strong>Reservation submitted</strong>
                        <span>@createdInSkopje.ToString("dd MMM yyyy, HH:mm")</span>
                    </li>
                }
                else
                {
                    @foreach (var activity in activities)
                    {
                        var activityAtUtc = DateTime.SpecifyKind(
                            activity.CreatedAtUtc,
                            DateTimeKind.Utc);

                        var activityAt = TimeZoneInfo
                            .ConvertTimeFromUtc(
                                activityAtUtc,
                                skopjeTimeZone)
                            .ToString("dd MMM yyyy, HH:mm");

                        <li>
                            <strong>@activity.Title</strong>
                            <span>
                                @activity.Actor / @activityAt /
                                @activity.Description
                            </span>
                        </li>
                    }
                }
            </ol>
        </details>
    </div>

    @if (canCancel)
    {
        <details class="admin-content-disclosure reservation-cancel-disclosure reservation-danger-zone">
            <summary>
                <span class="reservation-disclosure-title">
                    <small>Danger zone</small>
                    <strong>Cancel this booking</strong>
                </span>
                <span class="reservation-disclosure-value">Open</span>
            </summary>

            <form asp-controller="AdminReservations"
                  asp-action="Cancel"
                  method="post"
                  class="admin-form-surface"
                  onsubmit="return confirm('Cancel this reservation and release its table?');">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="admin-form-grid">
                    <label class="wide">
                        Optional cancellation note
                        <textarea name="adminNote"
                                  rows="2"
                                  maxlength="500"></textarea>
                    </label>
                </div>

                <button type="submit"
                        class="admin-primary-button is-danger">
                    Cancel booking
                </button>
            </form>
        </details>
    }

</div>

<script>
    (() => {
        const button = document.querySelector("[data-copy-phone]");
        const status = document.querySelector("[data-copy-phone-status]");

        button?.addEventListener("click", async () => {
            const phone = button.dataset.copyPhone || "";

            try {
                await navigator.clipboard.writeText(phone);
                button.textContent = "Copied";
                if (status) status.textContent = "Phone number copied.";
            } catch {
                if (status) status.textContent = `Phone: ${phone}`;
            }
        });
    })();
</script>
