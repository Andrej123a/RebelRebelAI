# Copy these keys into the hosting provider's environment-variable dashboard.
# ASP.NET Core does not load this file automatically.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=YOUR_NEON_HOST;Port=5432;Database=neondb;Username=YOUR_NEON_USER;Password=YOUR_NEON_PASSWORD;SSL Mode=Require
AllowedHosts=YOUR_PUBLIC_DOMAIN

# Keep database changes as an explicit deployment step.
Database__MigrateOnStartup=false

# Presentation-safe feature flags.
Presentation__HideAiFeatures=true
Menu__ShowDrinks=false

# Keep disabled after the initial admin account has been created.
AdminUser__BootstrapEnabled=false

# Optional while AI features are hidden.
OpenAI__ApiKey=
OpenAI__Model=gpt-5-mini

# Optional until guest email delivery is enabled.
EmailSettings__SmtpServer=
EmailSettings__Port=587
EmailSettings__SenderName=Rebel Rebel by Fat Kitchen
EmailSettings__SenderEmail=reservations@rebelrebel.mk
EmailSettings__Username=
EmailSettings__Password=
